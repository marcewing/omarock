#!/bin/bash
# build-libflac: libFLAC with patches/libflac-ogg-live.patch, for mpd only.
#
# mpd decodes the Apple Music stream (Ogg FLAC) through libFLAC. libFLAC's Ogg
# layer filled each 8 KiB read before returning any audio, so mpd tuning in
# while the stream was near-silent (a few hundred bytes a second) waited for
# 8 KiB, then played what it had buffered and stayed that far behind (42 s,
# once). Patched, it plays about two Ogg pages behind. The fix is offered
# upstream (xiph/flac); drop this once Arch's flac has it.
#
#   tools/build-libflac [DEST]     default DEST: ~/.local/lib/omarock-flac
#
# It builds the release of the flac version pacman has installed (same
# soname), patched, into DEST. Only mpd uses it, through a drop-in,
# ~/.config/systemd/user/mpd.service.d/omarock-flac.conf:
#   [Service]
#   Environment=LD_LIBRARY_PATH=%h/.local/lib/omarock-flac
# then: systemctl --user daemon-reload; systemctl --user restart mpd
# Check: ldd /usr/bin/mpd with that LD_LIBRARY_PATH, or
# grep libFLAC /proc/$(systemctl --user show -p MainPID --value mpd)/maps
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
dest=${1:-$HOME/.local/lib/omarock-flac}
version=$(pacman -Q flac | awk '{print $2}' | cut -d- -f1)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

echo "libFLAC $version, patched, into $dest"
git clone -q --depth 1 --branch "$version" https://github.com/xiph/flac.git "$work/flac"
git -C "$work/flac" apply "$repo/patches/libflac-ogg-live.patch"
cmake -G Ninja -S "$work/flac" -B "$work/build" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
  -DWITH_OGG=ON -DBUILD_CXXLIBS=OFF -DBUILD_PROGRAMS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF \
  -DBUILD_DOCS=OFF -DINSTALL_MANPAGES=OFF >/dev/null
ninja -C "$work/build" >/dev/null
install -d "$dest"
cp -P "$work/build/src/libFLAC/"libFLAC.so* "$dest/"
ls -l "$dest"
