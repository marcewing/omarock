#!/bin/bash
# build-mpd-mpris: mpd-mpris with patches/mpd-mpris-stream-art.patch.
#
# For a stream (the Apple Music, SiriusXM and radio entries in mpd's queue),
# mpd-mpris built the song again on every player event: every play, pause,
# stop and restart, including omarock's rejoin after each Apple Music change.
# Each time it asked mpd for the album art (readpicture, then albumart). For
# a stream, mpd opens and probes it to answer, and answers no other client
# meanwhile: 6 to 7 s for the Apple Music stream (ffmpeg probing it), so
# omarock's volume and status waited. Patched, it keeps a stream's art across
# events and doesn't ask mpd for a remote stream's art at all. Offered
# upstream with the other fixes; drop this once Arch's mpd-mpris has it.
#
#   tools/build-mpd-mpris [DEST]     default DEST: ~/.local/lib/omarock-mpris
#
# It builds mpd-mpris 0.4.4 (Arch's version), patched, into DEST/mpd-mpris.
# The user unit runs it through a drop-in,
# ~/.config/systemd/user/mpd-mpris.service.d/omarock-mpris.conf:
#   [Service]
#   ExecStart=
#   ExecStart=%h/.local/lib/omarock-mpris/mpd-mpris -no-instance
# then: systemctl --user daemon-reload; systemctl --user restart mpd-mpris
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
dest=${1:-$HOME/.local/lib/omarock-mpris}
version=$(pacman -Q mpd-mpris | awk '{print $2}' | cut -d- -f1)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The source is mpd-mpris 0.4.4's release commit, pinned: the patch was made
# and tested against it, and a tag could move. A newer one needs a new pin here.
if [[ $version != 0.4.4 ]]; then
  echo "The patch is pinned to mpd-mpris 0.4.4, and pacman has $version: not building." >&2
  exit 1
fi
echo "mpd-mpris $version, patched, into $dest"
git -c advice.detachedHead=false clone -q --depth 1 --branch v0.4.4 https://github.com/natsukagami/mpd-mpris.git "$work/mpd-mpris" &&
  git -C "$work/mpd-mpris" checkout -q --detach 69158f2765362ad9e1a658fa2b793a6f4c40f2f7 &&
  git -C "$work/mpd-mpris" apply "$repo/patches/mpd-mpris-stream-art.patch" &&
  (cd "$work/mpd-mpris" && GOFLAGS=-mod=mod go build -trimpath -buildvcs=false -o "$work/mpd-mpris.bin" ./cmd/mpd-mpris)
install -d "$dest"
install -m 755 "$work/mpd-mpris.bin" "$dest/mpd-mpris"
ls -l "$dest"
