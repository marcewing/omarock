#!/bin/bash
# omarock-account: omarock's accounts and keys, as the settings screen
# changes them (and you can too). A value comes on stdin, one line, and goes
# straight into its file in ~/.config/omarock, readable only by you (mode 600);
# nothing is printed. Then the service that uses it restarts, if it runs.
#
#   omarock-account show             what's set, as JSON: names, never secrets
#   omarock-account sxm-user         the SiriusXM email or username
#   omarock-account sxm-password     the SiriusXM password
#   omarock-account spotify-client   the Spotify developer app's Client ID
#   omarock-account soloist-key      Spotify's Soloist key
#   omarock-account bridge-token     the Apple Music bridge's token (and then the
#                                    stream's address, which the bridge gives
#                                    only with it, into apple.json)
#   omarock-account apple-bridge     the bridge's address (http://HOST:8710), into
#                                    apple.json, with its stream if the bridge
#                                    says where (from 0.9.0, only with the token)
#   omarock-account bridge-pair URL  pairs with the bridge at URL (from 0.10.0): the
#                                    pairing code the Mac shows comes on stdin, and
#                                    the token the bridge gives for it goes straight
#                                    into bridge-token (then the stream, as above).
#                                    On a failure, the bridge's reason on stderr,
#                                    and the exit code: 3 not the code, 4 no code
#                                    open on the Mac, 5 a bridge that can't pair
#                                    (before 0.10.0), 6 no answer, 7 not saved
#   omarock-account bridge-check URL whether the bridge at URL takes the token saved
#                                    here: exit 0 if it does, 1 if it refuses it,
#                                    6 if it doesn't answer, 8 if there's none
#   omarock-account music-folder     mpd's music folder: mpd.conf's music_directory
#                                    line only (a copy of mpd.conf first), then mpd
#                                    restarts and reads the folder
#
#   echo 'me@example.com' | tools/omarock-account sxm-user
set -uo pipefail
config=$HOME/.config/omarock
sxm=$config/siriusxm.json

write_private() {  # FILE: stdin into FILE, mode 600, all at once
  install -d -m 700 "$config"
  (umask 077 && cat >"$1.new") && chmod 600 "$1.new" && mv "$1.new" "$1"
}
value() {  # the one line on stdin, without its newline
  local v
  IFS= read -r v || [[ -n $v ]] || { echo "omarock-account: nothing on stdin" >&2; exit 2; }
  printf '%s' "$v"
}
# Saved is saved: a service that isn't there, or won't restart, says so in
# the settings (its health), not here.
restart() { systemctl --user try-restart "$1" 2>/dev/null || true; }
# The bridge's stream, as its health says, asked with the token if there is
# one (from bridge 0.9.0 the stream's address has a secret, given only with
# it). The token goes to curl on stdin, never on its command line.
apple_stream() {  # BRIDGE
  local token=""
  [[ -r $config/bridge-token ]] && token=$(<"$config/bridge-token")
  printf 'header = "Authorization: Bearer %s"\nheader = "X-Omarock: 1"\n' "${token//[$'\n\r "\\']/}" \
    | curl -s -m 5 -K - "$1/v1/health" 2>/dev/null | jq -r '.stream // empty' 2>/dev/null
}
bridge_url() {  # URL: the bridge's address, checked
  local b=${1%/}
  [[ $b =~ ^https?://[^/]+$ ]] || { echo "omarock-account: not a bridge's address: $1" >&2; exit 2; }
  printf '%s' "$b"
}
write_apple() {  # BRIDGE STREAM: apple.json, readable only by you
  # The stream's address has a secret in it, so it goes to jq on stdin, never
  # on its command line (which others on this machine can read).
  local json
  json=$(printf '%s' "${2//[$'\n\r']/}" \
    | jq -n --arg b "$1" --rawfile s /dev/stdin '{bridge: $b} + (if $s == "" then {} else {stream: $s} end)') \
    && printf '%s\n' "$json" | write_private "$config/apple.json"
}

case ${1:-} in
  show)
    python3 -I - "$sxm" "$config/spotify.json" "$config/soloist-key" "$config/bridge-token" "$config/apple.json" <<'EOF'
import json, os, sys
def load(path):
    try:
        with open(path) as f: return json.load(f)
    except Exception: return {}
sxm, spotify = load(sys.argv[1]), load(sys.argv[2])
def has(path): return os.path.isfile(path) and os.path.getsize(path) > 0
print(json.dumps({"sxmUser": sxm.get("username", ""), "sxmPassword": bool(sxm.get("password")),
                  "spotifyClient": spotify.get("clientId", ""), "soloistKey": has(sys.argv[3]),
                  "bridgeToken": has(sys.argv[4]), "appleBridge": load(sys.argv[5]).get("bridge", "")}))
EOF
    ;;
  sxm-user|sxm-password)
    # The other half of the login stays as it was.
    field=$([[ $1 == sxm-user ]] && echo username || echo password)
    value | python3 -I -c '
import json, sys
try:
    with open(sys.argv[1]) as f: login = json.load(f)
except Exception: login = {}
login[sys.argv[2]] = sys.stdin.read()
print(json.dumps({"username": login.get("username", ""), "password": login.get("password", "")}))' "$sxm" "$field" \
      | write_private "$sxm" && restart omarock-sxm ;;
  spotify-client)
    id=$(value) && jq -Rn '{clientId: input, redirectUri: "http://127.0.0.1:8730/callback"}' <<<"$id" \
      | write_private "$config/spotify.json" && restart omarock-spotify ;;
  soloist-key)
    value | { cat; echo; } | write_private "$config/soloist-key" && restart omarock-soloist ;;
  bridge-token)
    value | write_private "$config/bridge-token" || exit 1
    # With the token in, the bridge says where its stream is.
    bridge=$(jq -r '.bridge // empty' "$config/apple.json" 2>/dev/null)
    if [[ -n $bridge ]]; then
      stream=$(apple_stream "$bridge")
      [[ -n $stream ]] && write_apple "$bridge" "$stream"
    fi
    true ;;
  bridge-pair)
    bridge=$(bridge_url "${2:-}") || exit 2
    # Only the digits count ("048 213" is 048213), so they go into the JSON as they are.
    code=$(value | tr -cd '0-9') || exit 2
    [[ ${#code} == 6 ]] || { echo "A pairing code is 6 digits." >&2; exit 3; }
    client=$(tr -cd 'A-Za-z0-9._-' </etc/hostname 2>/dev/null | head -c 64)
    reply=$(printf '{"code":"%s"}' "$code" | curl -s -m 8 -w '\n%{http_code}' -H 'Content-Type: application/json' \
      -H "X-Omarock-Client: $client" --data-binary @- "$bridge/v1/pair" 2>/dev/null)
    status=${reply##*$'\n'}
    reply=${reply%$'\n'*}
    said=$(jq -r '.error // empty' <<<"$reply" 2>/dev/null)
    case $status in
      200)
        # The token goes from the reply into its file, never printed or on a command line.
        token=$(jq -r '.token // empty' <<<"$reply" 2>/dev/null)
        reply=""
        [[ -n $token ]] || { echo "The bridge answered without a token." >&2; exit 6; }
        printf '%s' "$token" | write_private "$config/bridge-token" || { token=""; echo "Couldn't save the token in $config." >&2; exit 7; }
        token=""
        # The stream, given only with the token, if apple.json is for this bridge.
        if [[ $(jq -r '.bridge // empty' "$config/apple.json" 2>/dev/null) == "$bridge" ]]; then
          stream=$(apple_stream "$bridge")
          [[ -n $stream ]] && write_apple "$bridge" "$stream"
        fi
        true ;;
      400|403) [[ -n $said ]] || said="That isn't the code the Mac shows."
        echo "$said" >&2; exit 3 ;;
      409) [[ -n $said ]] || said="No pairing code is open on the Mac: run ./install pair there."
        echo "$said" >&2; exit 4 ;;
      404) echo "The bridge on the Mac is older than 0.10.0, and can't pair: update it there (git pull, then ./install)." >&2; exit 5 ;;
      000|"") echo "Nothing answers at $bridge." >&2; exit 6 ;;
      *) [[ -n $said ]] || said="The bridge said $status."
        echo "$said" >&2; exit 6 ;;
    esac ;;
  bridge-check)
    bridge=$(bridge_url "${2:-}") || exit 2
    [[ -s $config/bridge-token ]] || exit 8
    token=$(<"$config/bridge-token")
    status=$(printf 'header = "Authorization: Bearer %s"\n' "${token//[$'\n\r "\\']/}" \
      | curl -s -m 5 -o /dev/null -w '%{http_code}' -K - "$bridge/v1/status" 2>/dev/null)
    token=""
    case $status in
      200) exit 0 ;;
      401) exit 1 ;;
      *) exit 6 ;;
    esac ;;
  apple-bridge)
    bridge=$(value) && bridge=${bridge%/}
    [[ $bridge =~ ^https?://[^/]+$ ]] || { echo "omarock-account: not a bridge's address: $bridge" >&2; exit 1; }
    write_apple "$bridge" "$(apple_stream "$bridge")" ;;
  music-folder)
    dir=$(value) && dir=${dir/#\~/$HOME}
    # mpd takes only absolute paths: "Music" is the one in your home folder.
    [[ $dir == /* ]] || dir=$HOME/$dir
    [[ -d $dir ]] || { echo "omarock-account: no folder $dir" >&2; exit 1; }
    # The config mpd reads, first found, as mpd looks.
    conf=""
    for f in "${XDG_CONFIG_HOME:-$HOME/.config}/mpd/mpd.conf" "$HOME/.mpdconf" "$HOME/.mpd/mpd.conf"; do
      [[ -f $f ]] && { conf=$f; break; }
    done
    [[ -n $conf ]] || { echo "omarock-account: mpd has no config of yours (run ./install)" >&2; exit 1; }
    cp -p "$conf" "$conf.before-omarock-$(date +%Y%m%d-%H%M%S)" || exit 1
    python3 -I - "$conf" "$dir" <<'EOF' || exit 1
import re, sys
path, folder = sys.argv[1], sys.argv[2]
line = 'music_directory     "%s"\n' % folder.replace("\\", "\\\\").replace('"', '\\"')
lines = open(path).read().splitlines(True)
for i, old in enumerate(lines):
    if re.match(r"\s*music_directory\s", old):
        lines[i] = line
        break
else:
    lines.insert(0, line)
open(path + ".new", "w").write("".join(lines))
EOF
    # With mpd.conf's own mode: it can hold mpd's passwords.
    chmod --reference="$conf" "$conf.new" && mv "$conf.new" "$conf" && systemctl --user restart mpd || exit 1
    # mpd reads the new folder once it answers again.
    socket=${XDG_RUNTIME_DIR:-/run/user/$UID}/mpd/socket
    for _ in $(seq 40); do MPD_HOST=$socket mpc status >/dev/null 2>&1 && break; sleep 0.5; done
    MPD_HOST=$socket mpc -q update ;;
  -h|--help|help|"") sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) echo "omarock-account: no such account: $1 (try --help)" >&2; exit 2 ;;
esac
