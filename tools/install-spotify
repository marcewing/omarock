#!/bin/bash
# install-spotify: install omarock's Spotify units from a commit (default
# HEAD) as copies, never from the working tree (as tools/install-audio): the
# Soloist unit pins Spotify's sound to omarock's bus. See spotify/README.md.
#
#   tools/install-spotify [COMMIT]          install, and reload systemd
#   tools/install-spotify --start [COMMIT]  ... then enable and (re)start them
#
# It installs omarock-spotify's Python files into ~/.local/share/omarock/spotify/
# and both units into ~/.config/systemd/user/.
set -euo pipefail
start=false
[[ ${1:-} == --start ]] && { start=true; shift; }
repo=$(cd "$(dirname "$0")/.." && pwd)
commit=$(git -C "$repo" rev-parse --verify "${1:-HEAD}^{commit}")
if ! git -C "$repo" diff --quiet "$commit" -- spotify/; then
  echo "note: spotify/ in the working tree differs from ${commit:0:7}; installing the commit's version" >&2
fi
units=$HOME/.config/systemd/user
dest=$HOME/.local/share/omarock/spotify
install -d "$units" "$dest"
for f in omarock-spotify.py soloist_ws.py spotify_web.py spotify_mpris.py; do
  git -C "$repo" show "$commit:spotify/$f" > "$dest/$f.new" && mv "$dest/$f.new" "$dest/$f"
done
echo "$commit" > "$dest/INSTALLED"
soloist_changed=false
for u in omarock-soloist omarock-spotify; do
  git -C "$repo" show "$commit:spotify/$u.service" > "$units/$u.service.new"
  if cmp -s "$units/$u.service.new" "$units/$u.service"; then
    rm "$units/$u.service.new"
  else
    mv "$units/$u.service.new" "$units/$u.service"
    [[ $u == omarock-soloist ]] && soloist_changed=true
  fi
done
systemctl --user daemon-reload
echo "omarock's Spotify units installed from ${commit:0:7}"
if $start; then
  systemctl --user enable omarock-soloist omarock-spotify
  # Restarting Soloist cuts off what it plays: only when its unit changed.
  if $soloist_changed; then systemctl --user restart omarock-soloist; else systemctl --user start omarock-soloist; fi
  systemctl --user restart omarock-spotify
  systemctl --user --no-pager --lines=0 status omarock-soloist omarock-spotify | grep -E "^●|Active:"
fi
