#!/bin/bash
# install-spotify: install omarock's Spotify units from a commit (default
# HEAD) as copies, never from the working tree (as tools/install-audio): the
# Soloist unit pins Spotify's sound to omarock's bus. See spotify/README.md.
#
#   tools/install-spotify [COMMIT]          install, and reload systemd
#   tools/install-spotify --start [COMMIT]  ... then enable and (re)start them
#
# It installs omarock-spotify's Python files into ~/.local/share/omarock/spotify/
# and both units into ~/.config/systemd/user/. There too, it builds
# omarock-soloist-shim.so (spotify/omarock-soloist-shim.c), which gives Soloist
# its key without the key on Soloist's command line, and lets only your
# account reach Soloist's control port: that needs a C compiler (cc, in
# Omarchy's base-devel).
#
# Soloist itself is the build you download from Spotify (tools/update-soloist
# installs it). With --start, a build that hasn't been checked with this shim
# yet (the shim or the unit changed, or it's new) is checked now: Soloist's
# unit starts only a build that passed.
set -euo pipefail
# What it writes is yours alone: folders 700, files 600.
umask 077
start=false
[[ ${1:-} == --start ]] && { start=true; shift; }
repo=$(cd "$(dirname "$0")/.." && pwd)
commit=$(git -C "$repo" rev-parse --verify "${1:-HEAD}^{commit}")
if ! git -C "$repo" diff --quiet "$commit" -- spotify/; then
  echo "note: spotify/ in the working tree differs from ${commit:0:7}; installing the commit's version" >&2
fi
units=$HOME/.config/systemd/user
dest=$HOME/.local/share/omarock/spotify
command -v cc >/dev/null || { echo "install-spotify: building omarock-soloist-shim.so needs a C compiler: sudo pacman -S --needed base-devel" >&2; exit 1; }
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
install -d "$units"
install -d -m 700 "$(dirname "$dest")" "$dest"
for f in omarock-spotify.py soloist_ws.py spotify_web.py spotify_mpris.py; do
  git -C "$repo" show "$commit:spotify/$f" > "$dest/$f.new" && mv "$dest/$f.new" "$dest/$f"
done
soloist_changed=false
# Built the same way each time, so a Soloist restarts only when it changed.
git -C "$repo" show "$commit:spotify/omarock-soloist-shim.c" > "$work/omarock-soloist-shim.c"
cc -O2 -Wall -shared -fPIC -o "$work/omarock-soloist-shim.so" "$work/omarock-soloist-shim.c" -ldl
if ! cmp -s "$work/omarock-soloist-shim.so" "$dest/omarock-soloist-shim.so"; then
  mv "$work/omarock-soloist-shim.so" "$dest/omarock-soloist-shim.so"
  soloist_changed=true
fi
# Its name before 1.0.5.
rm -f "$dest/omarock-soloist-key.so"
echo "$commit" > "$dest/INSTALLED"
for u in omarock-soloist omarock-spotify; do
  git -C "$repo" show "$commit:spotify/$u.service" > "$units/$u.service.new"
  if cmp -s "$units/$u.service.new" "$units/$u.service"; then
    rm "$units/$u.service.new"
  else
    mv "$units/$u.service.new" "$units/$u.service"
    [[ $u == omarock-soloist ]] && soloist_changed=true
  fi
done
systemctl --user daemon-reload
echo "omarock's Spotify units installed from ${commit:0:7}"
# Soloist's folders hold its Spotify sign-in: yours alone, as what it writes
# from now on is (its unit's UMask). Earlier versions left them readable.
private_soloist() {
  local d
  for d in "$HOME/.local/share/omarock-soloist" "$HOME/.cache/omarock-soloist"; do
    if [[ -d $d ]]; then chmod -R go= "$d"; fi
  done
}
private_soloist
if $start; then
  systemctl --user enable omarock-soloist omarock-spotify
  systemctl --user restart omarock-spotify
  soloist=$HOME/.local/lib/omarock-soloist
  checked() { (cd "$soloist" 2>/dev/null && sha256sum --check --status soloist.sha256 2>/dev/null); }
  if [[ ! -f $soloist/soloist ]]; then
    echo "No Soloist yet: ./install spotify installs the one you download from Spotify (or tools/update-soloist install)"
  elif $soloist_changed || ! checked; then
    # A shim or unit of its own, or a build not checked yet: check it now
    # (it restarts Soloist, cutting off what it plays).
    "$repo/tools/update-soloist" check || true
  else
    systemctl --user start omarock-soloist
  fi
  # Again: an older Soloist can still write as it stops.
  private_soloist
  shown=(omarock-spotify)
  checked && shown=(omarock-soloist omarock-spotify)
  systemctl --user --no-pager --lines=0 status "${shown[@]}" | grep -E "^●|Active:" || true
fi
