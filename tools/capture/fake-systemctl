#!/bin/bash
# The harness's systemctl (first on the panel's PATH): it never reaches a
# real service manager. It logs each call to $HOME/systemctl.log, and keeps
# the units enabled in $HOME/.fake-systemd, for is-enabled, enable and disable.
set -u
echo "$*" >>"$HOME/systemctl.log"
dir=$HOME/.fake-systemd
mkdir -p "$dir"
args=()
for a; do [[ $a == --user || $a == --quiet || $a == -q || $a == --now ]] || args+=("$a"); done
case ${args[0]:-} in
  is-enabled) [[ -e $dir/${args[1]%.service} ]] ;;
  is-active) [[ -e $dir/${args[1]%.service} ]] ;;
  enable) for u in "${args[@]:1}"; do touch "$dir/${u%.service}"; done ;;
  disable) for u in "${args[@]:1}"; do rm -f "$dir/${u%.service}"; done ;;
  *) exit 0 ;;
esac
