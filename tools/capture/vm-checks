#!/bin/bash
# vm-checks: what only a throwaway machine (a test VM) can check, before a
# release:
#   - another account on the machine can't use omarock's services:
#     omarock-spotify, omarock-sxm and Soloist's control port and discovery
#     port turn its connections away, and take this account's (and the
#     discovery port another machine's);
#   - a new Soloist build is taken, or turned down, as it should be: one put in
#     by hand isn't started until it's checked, one that can't work with
#     omarock's shim is turned down by reading it or by running it (and the
#     last good one put back), an expired one is turned down, and a newer
#     download is installed by ./install spotify (the settings' Update…).
# It installs omarock from this clone (local music, SiriusXM and Spotify, with
# made-up secrets), makes a second account, checks, then takes it all off.
#
#   OMAROCK_THROWAWAY=yes tools/capture/vm-checks [WORK-DIR]
#
# Nothing leaves the machine or is advertised: Spotify's and SiriusXM's hosts
# point at this machine (/etc/hosts, with sudo; taken out at the end), and
# Soloist is a stand-in (soloist-standin.c: the real one announces itself on
# the network), downloaded into ~/Downloads as Soloist would be.
set -uo pipefail
# matches ARGS…: grep ARGS >/dev/null, for "… | matches PATTERN". It reads to the end:
# grep -q stops at the first match, and the command writing into it, cut off, then
# fails the whole pipe (pipefail).
matches() { grep "$@" >/dev/null; }
if [[ ${OMAROCK_THROWAWAY:-} != yes ]]; then
  echo "vm-checks: only on a throwaway machine (it installs and removes everything, adds an account, and edits /etc/hosts)." >&2
  echo "  OMAROCK_THROWAWAY=yes $0 [WORK-DIR]" >&2
  exit 2
fi
repo=$(cd "$(dirname "$0")/../.." && pwd)
work=${1:-$(mktemp -d "$HOME/omarock-vm-checks.XXXXXX")}
mkdir -p "$work/logs" "$HOME/Music" "$HOME/Downloads"
set -a; eval "$(systemctl --user show-environment)"; set +a
export LANG=C.UTF-8
other=omarock-other
lib=$HOME/.local/lib/omarock-soloist
failures=0
check() {  # WHAT COMMAND...: ok or FAIL
  local what=$1; shift
  if "$@"; then echo "ok   $what"; else echo "FAIL $what"; failures=$((failures + 1)); fi
}

hosts="apresolve.spotify.com accounts.spotify.com api.spotify.com login5.spotify.com clienttoken.spotify.com
  spclient.wg.spotify.com api.edge-gateway.siriusxm.com imgsrv-sxm-prod-device.streaming.siriusxm.com
  lookaround-cache-prod.streaming.siriusxm.com www.siriusxm.com"
{ printf '127.0.0.1 %s # omarock-vm-checks\n' $hosts; printf '::1 %s # omarock-vm-checks\n' $hosts; } | sudo tee -a /etc/hosts >/dev/null
trap 'sudo sed -i "/# omarock-vm-checks\$/d" /etc/hosts; sudo userdel -r "$other" 2>/dev/null; sudo ip netns del omarock-other-machine 2>/dev/null; sudo ip link del omv0 2>/dev/null' EXIT
sleep 2
for h in api.edge-gateway.siriusxm.com apresolve.spotify.com; do
  getent ahosts "$h" | awk '{print $1}' | sort -u | matches -vE '^(127\.0\.0\.1|::1)$' && { echo "vm-checks: $h still resolves elsewhere" >&2; exit 1; }
done

now=$(date +%s)
standin() {  # ARCHIVE BUILT [CFLAGS...]: a stand-in Soloist built at BUILT, downloaded
  local into=$1 built=$2 d
  shift 2
  d=$(mktemp -d)
  cc -O2 "$@" -DBUILD="\"$built\"" -o "$d/soloist" "$repo/tools/capture/soloist-standin.c" \
    && tar -czf "$into" -C "$d" soloist
  rm -rf -- "$d"
}
run() {  # NAME ARGS...: ./install in answers mode ($work/answers-NAME)
  local name=$1; shift
  touch "$work/answers-$name"
  (cd "$repo" && OMAROCK_INSTALL_ANSWERS=$work/answers-$name ${limit:+timeout $limit} ./install "$@") >"$work/logs/$name.log" 2>&1
}
run_y() {  # the same, answering y to each yes/no question it stops on
  local name=$1 q; shift
  for _ in $(seq 16); do
    run "$name" "$@" && return 0
    q=$(grep -o "no answer for: .*" "$work/logs/$name.log" | sed "s/no answer for: //")
    [[ -z $q ]] && return 1
    [[ $q == *"?"* ]] || return 1
    echo "$q=y" >>"$work/answers-$name"
  done
}
acct() { "$repo/tools/omarock-account" "$@"; }
status() { "$repo/tools/update-soloist" status; }
installed() { status | jq -r ".installed.$1"; }
soloist_state() { systemctl --user show -p ActiveState -p ExecMainStatus --value omarock-soloist | paste -sd' '; }
since_start() {  # Soloist's log since it last started
  journalctl --user --no-pager -q -o cat "_SYSTEMD_INVOCATION_ID=$(systemctl --user show -p InvocationID --value omarock-soloist)"
}

echo "== omarock installed: local music, SiriusXM, Spotify (a stand-in Soloist)"
standin ~/Downloads/soloist_release_x86_64.tar.gz $((now - 7200))
printf '%s\n' "Where's your music?=$HOME/Music" "Where on the bar?=left" "Your area=" \
  "Open omarock with Super+Ctrl+M?=y" "Bring mpd back after a crash?=y" "Point mpd clients at the socket?=y" \
  "Keep mpd's files private?=y" >"$work/answers-base"
run_y base
printf 'me@example.com\n' | acct sxm-user; printf 'hunter 2\n' | acct sxm-password
printf '0123456789abcdef0123456789abcdef\n' | acct spotify-client; printf 'soloist-test-key\n' | acct soloist-key
printf '%s\n' "Set it up anyway?=y" "Enter the SiriusXM login again?=n" >"$work/answers-sxm"
limit=180 run_y sxm siriusxm --yes terms
printf '%s\n' "Install this Soloist?=y" "Open them for the pairing (sudo ufw)?=n" "Sign in now?=n" >"$work/answers-spotify"
limit=120 run_y spotify spotify
check "./install spotify installed the downloaded Soloist, checked with omarock" \
  [ "$(installed checked)" = true -a "$(installed built)" = $((now - 7200)) ]
guarded=$(since_start | grep -c '^omarock-soloist: guards ')
check "Soloist runs under the shim, which guards its control port and its discovery port ($guarded)" [ "$(soloist_state)" = "active 0" -a "$guarded" = 2 ]
refused=$(since_start | grep -c 'omarock-soloist: refused')
check "and refused none of this account's connections, the install's own check included ($refused)" [ "$refused" = 0 ]

echo "== another account"
sudo useradd -m "$other" 2>/dev/null || true
code() { curl -s -o /dev/null -w '%{http_code}' -m 5 -H 'X-Omarock: 1' "$1"; }
as_other() { sudo -u "$other" -H "$@"; }
mine=$(code http://127.0.0.1:8730/v1/health) theirs=$(as_other curl -s -o /dev/null -w '%{http_code}' -m 5 -H 'X-Omarock: 1' http://127.0.0.1:8730/v1/health)
check "omarock-spotify answers this account ($mine) and refuses another's ($theirs)" [ "$mine" = 200 -a "$theirs" = 403 ]
mine=$(code http://127.0.0.1:8720/v1/health) theirs=$(as_other curl -s -o /dev/null -w '%{http_code}' -m 5 -H 'X-Omarock: 1' http://127.0.0.1:8720/v1/health)
check "omarock-sxm answers this account ($mine) and refuses another's ($theirs)" [ "$mine" != 403 -a "$mine" != 000 -a "$theirs" = 403 ]
theirs=$(as_other curl -s -o /dev/null -w '%{http_code}' -m 5 http://127.0.0.1:8720/stream/x)
check "and its streams too ($theirs)" [ "$theirs" = 403 ]
greet='import socket, sys; s = socket.create_connection((sys.argv[1], int(sys.argv[2])), timeout=5); s.settimeout(5); print(s.recv(16).decode().strip() or "closed")'
mine=$(python3 -I -c "$greet" 127.0.0.1 8731 2>&1) theirs=$(as_other python3 -I -c "$greet" 127.0.0.1 8731 2>&1)
check "Soloist's control port takes this account's connection ($mine) and closes another's ($theirs)" \
  [ "$mine" = soloist -a "$theirs" = closed ]
check "and the shim says so in Soloist's log" bash -c "journalctl --user --no-pager -q -o cat -u omarock-soloist | grep -q 'refused a connection to port 8731 from another account'"
# Its Spotify Connect discovery, on every interface: this machine's other
# accounts are turned away, another machine isn't (a network namespace with
# a veth pair plays the other machine: nothing outside the VM is involved).
pid=$(systemctl --user show -p MainPID --value omarock-soloist)
dport=$(ss -ltnpH | awk -v p="pid=$pid," 'index($0, p) && $4 !~ /^127\./ {n = split($4, a, ":"); print a[n]; exit}')
own=$(ip -4 -o addr show scope global | awk '{split($4, a, "/"); print a[1]; exit}')
mine=$(python3 -I -c "$greet" "$own" "$dport" 2>&1) theirs=$(as_other python3 -I -c "$greet" "$own" "$dport" 2>&1)
check "Soloist's discovery port (${dport:-none}) takes this account's connection from this machine ($mine) and closes another account's ($theirs)" \
  [ -n "$dport" -a "$mine" = zeroconf -a "$theirs" = closed ]
sudo ip netns add omarock-other-machine
sudo ip link add omv0 type veth peer name omv1
sudo ip link set omv1 netns omarock-other-machine
sudo ip addr add 10.98.0.1/24 dev omv0; sudo ip link set omv0 up
sudo ip netns exec omarock-other-machine sh -c 'ip link set lo up; ip addr add 10.98.0.2/24 dev omv1; ip link set omv1 up'
sudo ufw allow in on omv0 >/dev/null 2>&1
theirs=$(sudo ip netns exec omarock-other-machine python3 -I -c "$greet" 10.98.0.1 "$dport" 2>&1)
check "and another machine's, as before (a phone pairing): $theirs" [ "$theirs" = zeroconf ]
sudo ufw delete allow in on omv0 >/dev/null 2>&1; sudo ip link del omv0 2>/dev/null; sudo ip netns del omarock-other-machine

echo "== a Soloist put in by hand"
standin "$work/by-hand.tar.gz" $((now - 3600))
# As tar puts it there, over the one running: a new file in its place.
tar -xzf "$work/by-hand.tar.gz" -C "$lib" soloist
systemctl --user restart omarock-soloist; sleep 2
check "it isn't started (79): $(soloist_state)" [ "$(soloist_state)" = "failed 79" ]
check "omarock's settings hear it was replaced and stopped" \
  [ "$("$repo/tools/omarock-sources" state | jq -r '.spotify.soloist | .why + " " + .stopped')" = "replaced unchecked" ]
"$repo/tools/update-soloist" check >"$work/logs/check.log" 2>&1
check "update-soloist check passes it, and it runs" [ "$(installed checked)" = true -a "$(soloist_state)" = "active 0" ]
good=$(sha256sum "$lib/soloist" | cut -d' ' -f1)

echo "== builds omarock turns down"
standin "$work/no-accept.tar.gz" $((now - 600)) -DNO_ACCEPT
"$repo/tools/update-soloist" install "$work/no-accept.tar.gz" >"$work/logs/no-accept.log" 2>&1
check "one that takes connections another way: turned down by reading it, never run" \
  bash -c "grep -q \"doesn't take connections through glibc's accept\" '$work/logs/no-accept.log' && [[ \$(sha256sum '$lib/soloist' | cut -d' ' -f1) == $good ]]"
standin "$work/expired.tar.gz" $((now - 100 * 86400))
"$repo/tools/update-soloist" install "$work/expired.tar.gz" >"$work/logs/expired.log" 2>&1
check "an expired one: turned down by reading it" grep -q 'has expired' "$work/logs/expired.log"
standin "$work/deaf.tar.gz" $((now - 300)) -DDEAF
"$repo/tools/update-soloist" install "$work/deaf.tar.gz" >"$work/logs/deaf.log" 2>&1
check "one whose control port the shim never sees: turned down by running it, the last good one back and running" \
  bash -c "grep -q \"didn't see it take a connection\" '$work/logs/deaf.log' && grep -q 'Put back the Soloist that worked' '$work/logs/deaf.log' \
    && [[ \$(sha256sum '$lib/soloist' | cut -d' ' -f1) == $good ]] && [[ \$(systemctl --user is-active omarock-soloist) == active ]]"
check "and it still passes as checked" [ "$(installed checked)" = true ]

echo "== downloads omarock doesn't take on its own"
standin ~/Downloads/soloist_release_x86_64.tar.gz $((now - 120))
setfattr -n user.xdg.origin.url -v https://downloads.example.net/soloist_release_x86_64.tar.gz ~/Downloads/soloist_release_x86_64.tar.gz
check "one your browser says came from elsewhere: not offered to the settings" \
  [ "$("$repo/tools/omarock-sources" state | jq -r .spotify.soloist.download)" != true ]
limit=120 run_y foreign spotify
"$repo/tools/update-soloist" install ~/Downloads/soloist_release_x86_64.tar.gz >"$work/logs/foreign.log" 2>&1
check "nor installed, by ./install spotify or by name" \
  bash -c "[[ \$(sha256sum '$lib/soloist' | cut -d' ' -f1) == $good ]] && grep -q 'not Spotify' '$work/logs/foreign.log'"
setfattr -x user.xdg.origin.url ~/Downloads/soloist_release_x86_64.tar.gz
printf '%s\n' "Install this Soloist?=n" "Open them for the pairing (sudo ufw)?=n" "Sign in now?=n" >"$work/answers-unsure"
limit=120 run unsure spotify
check "one with no recorded origin is shown and asked about: no, so it stays in Downloads" \
  bash -c "grep -q 'Install this Soloist?' '$work/logs/unsure.log' && [[ \$(sha256sum '$lib/soloist' | cut -d' ' -f1) == $good ]]"

echo "== a newer download, by ./install spotify (the settings' Update…)"
standin ~/Downloads/soloist_release_x86_64.tar.gz $((now - 60))
check "omarock's settings see it waiting" [ "$("$repo/tools/omarock-sources" state | jq -r .spotify.soloist.download)" = true ]
limit=120 run_y update spotify
check "it's installed and checked" [ "$(installed built)" = $((now - 60)) -a "$(installed checked)" = true ]
"$repo/tools/omarock-doctor" >"$work/logs/doctor.log" 2>&1
check "the doctor: only your account reaches Soloist's control port" grep -q "only your account reaches Soloist's control port" "$work/logs/doctor.log"

echo "== taken off again"
for p in siriusxm spotify; do : >"$work/answers-rm-$p"; run_y rm-$p --remove $p; done
printf '%s\n' "Take omarock off=y" >"$work/answers-uninstall"; run_y uninstall --uninstall
rm -f ~/Downloads/soloist_release_x86_64.tar.gz

echo
echo "$failures failure(s); logs in $work/logs"
((failures == 0))
