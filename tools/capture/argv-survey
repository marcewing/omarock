#!/usr/bin/env python3
"""argv-survey: is anything private on a command line? Any account on the
machine can read every program's command line (ps), so omarock passes keys,
tokens, logins and files' contents on stdin. This checks it: every program
started is logged with its whole command line (execlog.c, loaded with
LD_PRELOAD), and the log is searched for the made-up secrets the tests plant.
Run it before every published release (DEVELOPING.md, "Before a release").

  tools/capture/argv-survey capture [OUT-DIR]   the whole harness, logged (long)
  tools/capture/argv-survey scan LOG-DIR [NAME=VALUE ...]
                                                 search a log, with more secrets
  tools/capture/argv-survey build DIR            just build DIR/execlog.so

It fails on a planted secret (or a stream address with a secret in it) on any
command line but the harness's own: it types into the panel (qs ipc ...
typeKeys) and starts its fakes with their token. It also lists arguments that
look like a file's contents (several lines, long, JSON), for a person to read:
jq's and python3's programs look like that too. tools/capture/argv-installer
does the same for ./install and the tools, on a throwaway machine.
"""
import collections
import hashlib
import hmac
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
TOKEN = "fake-bridge-token"
# What the harness and argv-installer type or write in.
PLANTED = {
    "the bridge's token": TOKEN,
    "the stream's secret": hmac.new(TOKEN.encode(), b"stream", hashlib.sha256).hexdigest()[:32],
    "the private-files scenario's secret": hashlib.sha256(b"private-files").hexdigest()[:32],
    "the Soloist key": "soloist-test-key",
    "a SiriusXM password": "hunter 2",
    "another SiriusXM password": "pass word",
    "the SiriusXM username": "me@example.com",
    "the Spotify Client ID": "0123456789abcdef0123456789abcdef",
    "your area": "Portland, Maine",
}
CODES = ["048213", "300400", "654321", "111111"]  # pairing codes
STREAM = re.compile(r"omarock-[0-9a-f]{32}\.ogg")


def build(folder):
    so = Path(folder) / "execlog.so"
    subprocess.run(["cc", "-O2", "-Wall", "-shared", "-fPIC", "-o", str(so), str(HERE / "execlog.c"), "-ldl"], check=True)
    return so


def harness_own(argv):
    """The harness's own command lines: it types into the panel, and starts its fakes."""
    name = os.path.basename(argv[0]) if argv else ""
    if name == "qs" and "ipc" in argv[1:3]:
        return True
    return name.startswith("python") and any(re.search(r"/fake_[a-z]+\.py$", a) for a in argv[1:4])


def scan(logdir, planted):
    records = []
    for f in sorted(os.listdir(logdir)):
        try:
            records.append(json.loads((Path(logdir) / f).read_text(errors="replace")))
        except (OSError, ValueError):
            pass
    found = collections.defaultdict(list)
    shaped = collections.defaultdict(collections.Counter)
    own = 0
    for r in records:
        argv = r.get("argv") or []
        name = os.path.basename(argv[0]) if argv else "?"
        if harness_own(argv):
            own += 1
            continue
        script = name in ("sh", "bash", "zsh", "dash") and len(argv) > 2 and argv[1] == "-c"
        for i, a in enumerate(argv):
            for what, value in planted.items():
                if value in a:
                    found[(what, name, i)].append(argv)
            if any(re.search(r"(?<!\d)" + c + r"(?!\d)", a) for c in CODES):
                found[("a pairing code", name, i)].append(argv)
            if STREAM.search(a):
                found[("a stream address with its secret", name, i)].append(argv)
            if script and i == 2:
                continue  # sh -c's script is code
            kind = []
            if "\n" in a: kind.append("several lines")
            if len(a) > 300: kind.append(f"long ({len(a)})")
            if a.strip()[:1] in "{[" and len(a.strip()) > 2:
                try:
                    json.loads(a); kind.append("JSON")
                except ValueError:
                    pass
            if kind:
                shaped[(name, i, ", ".join(kind))][a[:70].replace("\n", "\\n")] += 1
    print(f"{len(records)} programs started ({own} of them the harness's own)")
    print("\nShaped like a file's contents (read them: programs for jq or python3 are fine):")
    for (name, i, kind), seen in sorted(shaped.items()):
        print(f"  {name} argument {i}, {kind}: {sum(seen.values())}x, e.g. {seen.most_common(1)[0][0]!r}")
    if not shaped:
        print("  none")
    print("\nPlanted secrets on a command line:")
    for (what, name, i), argvs in sorted(found.items()):
        print(f"  FAIL {what}: {name} argument {i}, {len(argvs)}x; e.g. {json.dumps(argvs[0])[:240]}")
    if not found:
        print("  none")
    return not found


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if args else 2)
    if args[0] == "build" and len(args) == 2:
        print(build(args[1]))
    elif args[0] == "scan" and len(args) >= 2:
        planted = dict(PLANTED)
        for extra in args[2:]:
            name, _, value = extra.partition("=")
            planted[name] = value
        sys.exit(0 if scan(args[1], planted) else 1)
    elif args[0] == "capture" and len(args) <= 2:
        out = Path(args[1]) if len(args) == 2 else Path(tempfile.mkdtemp(prefix="omarock-argv-"))
        out.mkdir(parents=True, exist_ok=True)
        logdir = out / "execlog"
        logdir.mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory() as tmp:
            so = build(tmp)
            env = dict(os.environ, LD_PRELOAD=str(so), OMAROCK_EXECLOG=str(logdir))
            ran = subprocess.run([sys.executable, str(HERE / "capture.py"), str(out / "capture")], env=env)
        print(f"\nthe harness: exit {ran.returncode}; the log: {logdir}")
        clean = scan(logdir, PLANTED)
        sys.exit(0 if clean and ran.returncode == 0 else 1)
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
