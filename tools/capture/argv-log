#!/bin/sh
# The harness's sh and jq: the real ones, but while $HOME/argv.log exists,
# each command line they're given is written there first, one argument a
# line, so a scenario can check that no secret reaches a command line (where
# other accounts on this machine can read it).
if [ -f "$HOME/argv.log" ]; then
  for a in "$0" "$@"; do printf '%s\n' "$a"; done >>"$HOME/argv.log"
fi
exec "/usr/bin/${0##*/}" "$@"
