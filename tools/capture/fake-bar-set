#!/bin/bash
# fake-bar-set: stands in for `omarchy bar set` in capture.py's runs, so a test
# never writes a real shell.json. Like Omarchy's bar, it hands the setting back
# to the widget (through the test shell's IPC), and it logs each call.
#
#   fake-bar-set ID KEY VALUE [--json]
set -euo pipefail
id=$1 key=$2 value=$3 json=false
[[ ${4:-} == --json ]] && json=true
printf '{"id": "%s", "key": "%s", "value": "%s", "json": %s}\n' "$id" "$key" "$value" "$json" >> "$OMAROCK_SET_SETTING_LOG"
qs ipc -p "$OMAROCK_CAPTURE_SHELL" call capture setSetting "$key" "$value" "$json" > /dev/null
echo "Set $key on $id"
