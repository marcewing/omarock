#!/usr/bin/env python3
"""pin-sxm: write sxm/requirements.txt, omarock-sxm's Python packages pinned to
exact versions with the SHA-256 of every file PyPI has for each (so pip, with
--require-hashes, installs nothing else on any machine). tools/install-sxm
installs from it.

    tools/pin-sxm NAME==VERSION ...    e.g. aiosxm==0.3.1 aiohttp==3.14.5 ...

Give every package the venv needs, dependencies too: pip refuses one without a
pin. A working venv's list: ~/.local/share/omarock/sxm-venv/bin/pip freeze."""
import json
import sys
import urllib.request
from pathlib import Path

pins = sys.argv[1:]
if not pins or any("==" not in p for p in pins):
    sys.exit(__doc__)
out = ["# omarock-sxm's Python packages, for pip install --require-hashes -r.",
       "# Written by tools/pin-sxm, which says how to change them.", ""]
for pin in sorted(pins, key=str.lower):
    name, version = pin.split("==")
    with urllib.request.urlopen(f"https://pypi.org/pypi/{name}/{version}/json", timeout=20) as reply:
        files = json.load(reply)["urls"]
    if not files:
        sys.exit(f"pin-sxm: PyPI has no files for {pin}")
    hashes = sorted({f["digests"]["sha256"] for f in files})
    out.append(f"{name}=={version} \\")
    out += [f"    --hash=sha256:{h}" + (" \\" if i < len(hashes) - 1 else "") for i, h in enumerate(hashes)]
path = Path(__file__).resolve().parent.parent / "sxm" / "requirements.txt"
path.write_text("\n".join(out) + "\n")
print(f"wrote {path}: {len(pins)} packages")
