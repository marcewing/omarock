# Spotify's Soloist for omarock: a Spotify Connect speaker named after the machine (%H).
# With omarock's sound output set up (the bus, audio/), it plays into that, never
# straight to a sound card, and its own volume stays at 100: the bus's volume is
# omarock's one volume. Without it, it plays into the default output, and its
# own volume is the volume. It picks as it starts: ./install sound and
# ./install --remove sound restart it.
# Its WebSocket API (no authentication) listens on this machine only.
# Installed by tools/install-spotify from a commit; the binary by
# tools/update-soloist (Spotify's builds expire after 90 days: an expired one
# exits with 10, which isn't restarted). Without its key it says so and stops
# (78), rather than printing its usage every 5 s.
# It waits for the network first: Soloist tries to log in once, at start, and a
# session started before the network (a boot) stayed logged out. A user unit
# can't wait for network-online.target, which is the system's.
[Unit]
Description=Spotify's Soloist for omarock (a Spotify Connect speaker)
After=pipewire.service omarock-bus.service
Wants=omarock-bus.service

[Service]
ExecStart=/bin/sh -c 'key=%h/.config/omarock/soloist-key; [ -s "$$key" ] || { echo "omarock-soloist: no Soloist key in $$key (spotify/README.md, step 3)" >&2; exit 78; }; until getent hosts apresolve.spotify.com >/dev/null; do [ -n "$$waiting" ] || echo "omarock-soloist: waiting for the network" >&2; waiting=1; sleep 2; done; if [ -e %h/.local/share/omarock/audio/omarock-bus.conf ]; then set -- --pipewire-device omarock --initial-volume 100; else set -- --initial-volume 40; fi; exec %h/.local/lib/omarock-soloist/soloist --device-name %H --api-key "$$(cat "$$key")" --data-dir %h/.local/share/omarock-soloist --cache-dir %h/.cache/omarock-soloist --cache-size 500 "$$@" --ws 127.0.0.1:8731'
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=10 78

[Install]
WantedBy=default.target
