#!/bin/bash
# install: set omarock up. On its own it sets up local music and the radio:
# mpd (which plays the music), the bar plugin, and the radio's local stations.
# Spotify, SiriusXM and Apple Music each have a setup of their own, which
# omarock's settings run in a terminal (their Set up buttons), or you can run
# here. Each step checks what's there first, says what it will change, and asks
# before changing it; every command it runs is shown. Run any of them again
# whenever you like: what's done is skipped, a setup that stopped carries on,
# and one that's out of date is updated.
#
#   ./install                  local music and the radio, from a clone of
#                              omarock, in a terminal on the desktop
#   ./install spotify          Spotify
#   ./install siriusxm         SiriusXM
#   ./install apple-music      Apple Music, from omarock's bridge on your Mac
#   ./install sound            omarock's own sound output, optional: one volume,
#                              and one output it never leaves
#   ./install --remove PIECE   take one of those four off again, with its
#                              accounts and keys
#   ./install --uninstall      take omarock off, a piece at a time, asking first
#   ./install --help
#
# On a Mac, ./install sets up the Apple Music bridge instead (bridge/install).
#
# Secrets (the Soloist key, the SiriusXM login, the bridge's token) are typed
# into hidden prompts and go straight into files only you can read
# (~/.config/omarock, mode 600). Nothing is printed or passed on a command line.
#
# Each run says how it went in ~/.local/state/omarock/setup.json, which
# omarock's settings follow: what it set up or removed, and whether it's still
# running, done, failed or stopped.
#
# For tests, OMAROCK_INSTALL_ANSWERS=FILE answers the prompts from FILE, without
# gum: a line per prompt, `TEXT=ANSWER`, where TEXT is part of the prompt and
# ANSWER is y or n, a choice's key, comma-separated keys, or text. Waits are
# cut to 20 s, and a prompt asked 5 times (a retry its answer can't end) stops
# the run.
set -uo pipefail

# Before anything bash 4: a Mac's own bash is 3.2.
[[ $(uname) == Darwin ]] && exec "$(dirname "$0")/bridge/install" ${1+"$@"}

repo=$(cd "$(dirname "$0")" && pwd)
plugin_id=$(jq -r .id "$repo/manifest.json" 2>/dev/null)
plugin_dir=$HOME/.config/omarchy/plugins/$plugin_id
shelljson=$HOME/.config/omarchy/shell.json
config=$HOME/.config/omarock
units=$HOME/.config/systemd/user
share=$HOME/.local/share/omarock
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarock
answers=${OMAROCK_INSTALL_ANSWERS:-}
asked=""          # with answers: a file of the prompts answered so far
[[ -n $answers ]] && asked=$(mktemp -t omarock-install.XXXXXX)
again=./install   # what to run to carry on, after a stop
flow=""           # what this run sets up or removes (local, spotify, ...), for setup.json
action=setup      # or remove

bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m' green=$'\e[32m' red=$'\e[31m' yellow=$'\e[33m'
ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
bad() { printf '  %s✗%s %s\n' "$red" "$reset" "$*"; }
note() { printf '  %s–%s %s\n' "$yellow" "$reset" "$*"; }
explain() { printf '%s\n' "$*" | fold -s -w 76 | sed 's/^/  /'; }
step_no=0
step() { step_no=$((step_no + 1)); printf '\n%s%d. %s%s\n' "$bold" "$step_no" "$*" "$reset"; }

# A command, shown as it would be typed (on stderr, so its output can be
# silenced alone), then run.
run() {
  local shown="" a
  for a in "$@"; do
    if [[ $a =~ ^[A-Za-z0-9_./:=@%+,~-]+$ ]]; then shown+=" $a"; else shown+=" '${a//\'/\'\\\'\'}'"; fi
  done
  printf '  %s$%s%s\n' "$dim" "$shown" "$reset" >&2
  "$@"
}

# Ctrl-C or Esc at a prompt. The prompts run in $(…), so this goes to stderr,
# and the caller exits (`|| exit 1`).
stopped() {
  printf '\n%sStopped.%s Run %s again to carry on from here.\n' "$bold" "$reset" "$again" >&2
  exit 1
}

# ---- Prompts: gum in a terminal, or the answers file in tests ----

# The answers file has a line per prompt, `TEXT=ANSWER`: the first line whose
# TEXT is in the prompt answers it. By text, not order, since some prompts
# come only sometimes (mpd still reading the music, say).
answer() {  # PROMPT: the prompt's answer from the file
  local key value
  # The same prompt again and again is a retry the file's answer never gets out of.
  if (($(grep -cxF -- "$1" "$asked") >= 5)); then
    echo "install: asked 5 times, giving up: $1" >&2
    kill -TERM $$
    exit 3
  fi
  printf '%s\n' "$1" >>"$asked"
  while IFS='=' read -r key value; do
    [[ -n $key && $1 == *"$key"* ]] || continue
    printf '%s' "$value"
    return 0
  done <"$answers"
  echo "install: no answer for: $1" >&2
  kill -TERM $$
  exit 3
}

# A prompt answered from the file, as the run's output shows it: the
# question, how gum would offer it (the default, a placeholder), the answer.
answered() {  # PROMPT HOW ANSWER
  printf '  ? %s%s  %s→ %s%s\n' "$1" "${2:+ $dim$2$reset}" "$bold" "$3" "$reset" >&2
}

# confirm PROMPT [yes|no]: the default is yes.
confirm() {
  if [[ -n $answers ]]; then
    local a
    a=$(answer "$1")
    answered "$1" "$([[ ${2:-yes} == yes ]] && echo "[Yes] No" || echo "Yes [No]")" "$([[ $a == y* ]] && echo Yes || echo No)"
    [[ $a == y* ]]
    return
  fi
  local rc
  gum confirm --default="$([[ ${2:-yes} == yes ]] && echo true || echo false)" "$1"
  rc=$?
  ((rc == 130)) && stopped
  return $rc
}

# ask PROMPT [VALUE] [PLACEHOLDER]: a line of text.
ask() {
  if [[ -n $answers ]]; then
    local a
    a=$(answer "$1")
    answered "$1" "${2:+[filled in: $2]}${3:+[placeholder: $3]}" "${a:-(Enter)}"
    printf '%s' "$a"
    return
  fi
  gum input --header "$1" --value "${2:-}" --placeholder "${3:-}" --width 72 || stopped
}

# secret PROMPT: a line of text that isn't shown.
secret() {
  if [[ -n $answers ]]; then
    local a
    a=$(answer "$1")
    answered "$1" "[hidden as it's typed]" "$([[ -n $a ]] && echo "••••" || echo "(Enter)")"
    printf '%s' "$a"
    return
  fi
  gum input --password --header "$1" --width 72 || stopped
}

# choose HEADER DEFAULT KEY LABEL [KEY LABEL ...]: one key. Labels show; keys come back.
choose() {
  local header=$1 default=$2 labels=() keys=() selected="" i picked
  shift 2
  while (($#)); do keys+=("$1"); labels+=("$2"); shift 2; done
  if [[ -n $answers ]]; then
    picked=$(answer "$header")
    for i in "${!keys[@]}"; do [[ ${keys[i]} == "$picked" ]] && selected=${labels[i]}; done
    answered "$header" "" "${selected:-$picked}"
    for i in "${!labels[@]}"; do
      printf '      • %s%s\n' "${labels[i]}" "$([[ ${keys[i]} == "$default" ]] && echo "$dim  (the cursor starts here)$reset")" >&2
    done
    printf '%s' "$picked"
    return
  fi
  for i in "${!keys[@]}"; do [[ ${keys[i]} == "$default" ]] && selected=${labels[i]}; done
  picked=$(gum choose --header "$header" ${selected:+--selected "$selected"} "${labels[@]}") || stopped
  for i in "${!labels[@]}"; do [[ ${labels[i]} == "$picked" ]] && printf '%s' "${keys[i]}"; done
  return 0
}

# wait_until TITLE SECONDS COMMAND...: COMMAND again every 2 s until it
# succeeds, with a spinner. Ctrl-C gives up waiting, not the installer.
wait_until() {
  local title=$1 secs=$2 end frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 given_up=false met=false tty=""
  shift 2
  [[ -n $answers ]] && ((secs > 20)) && secs=20
  end=$((SECONDS + secs))
  # Keys typed meanwhile (Ctrl-C's ^C too) aren't echoed over the spinner.
  [[ -z $answers ]] && tty=$(stty -g 2>/dev/null) && stty -echo -echoctl 2>/dev/null
  trap 'given_up=true' INT
  while :; do
    if "$@" >/dev/null 2>&1; then met=true; break; fi
    if $given_up || ((SECONDS >= end)); then break; fi
    if [[ -n $answers ]]; then sleep 2; continue; fi
    local _
    for _ in 1 2 3 4 5 6 7 8; do
      printf '\r  %s %s' "${frames:i++ % 10:1}" "$title"
      sleep 0.25
      $given_up && break
    done
  done
  trap 'exit 130' INT
  [[ -n $tty ]] && stty "$tty" 2>/dev/null
  [[ -z $answers ]] && printf '\r\e[K'
  $met
}

# ---- What's there ----

# setting KEY DEFAULT: omarock's setting, from its entry in Omarchy's shell.json.
# omarock's settings: its own file, else (as before 0.6) its entry in
# Omarchy's shell.json, else DEFAULT.
setting() {  # KEY DEFAULT
  python3 -I - "$config/settings.json" "$shelljson" "$plugin_id" "$1" "$2" <<'PY'
import json, sys
mine, path, plugin, key, default = sys.argv[1:]
try:
    v = json.load(open(mine)).get(key)
    if v is not None:
        print(str(v).lower() if isinstance(v, bool) else v)
        sys.exit(0)
except Exception:
    pass
try:
    d = json.load(open(path))
    for items in (d.get("bar", {}).get("layout", {}) or {}).values():
        for it in items:
            if isinstance(it, dict) and it.get("id") == plugin and key in it:
                v = it[key]
                print(str(v).lower() if isinstance(v, bool) else v)
                sys.exit(0)
except Exception:
    pass
print(default)
PY
}
# The settings to make once the plugin is on the bar: key -> JSON value.
declare -A pending=()

manifest_version() { python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$1" 2>/dev/null; }
newer() { [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1) == "$1" ]]; }
active() { systemctl --user is-active --quiet "$1"; }
health() { curl -s -m 5 "$1/v1/health" 2>/dev/null; }

mpd_socket=""
mpd_answers() { [[ -S $mpd_socket ]] && MPD_HOST=$mpd_socket mpc status >/dev/null 2>&1; }

# The config mpd reads, first found (as mpd looks), or where a new one goes.
mpd_conf() {
  local f
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/mpd/mpd.conf" "$HOME/.mpdconf" "$HOME/.mpd/mpd.conf"; do
    [[ -f $f ]] && { echo "$f"; return; }
  done
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/mpd/mpd.conf"
}
conf_value() { grep -E "^[[:space:]]*$2[[:space:]]" "$1" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*[a-z_]+[[:space:]]+"?([^"]*)"?.*/\1/'; }
set_conf_value() {  # FILE KEY VALUE: KEY's line becomes VALUE (or is added, first)
  python3 -I - "$@" <<'PY'
import re, sys
path, key, value = sys.argv[1:]
line = '%-19s "%s"\n' % (key, value.replace("\\", "\\\\").replace('"', '\\"'))
lines = open(path).read().splitlines(True)
for i, old in enumerate(lines):
    if re.match(r"\s*%s\s" % key, old):
        lines[i] = line
        break
else:
    lines.insert(0, line)
open(path, "w").write("".join(lines))
PY
}
backed_up=""
backup() {  # FILE: a copy beside it, once a run
  [[ -f $1 && $backed_up != *"|$1|"* ]] || return 0
  local copy
  copy="$1.before-omarock-$(date +%Y%m%d-%H%M%S)"
  cp -p "$1" "$copy" && note "kept a copy: $copy"
  backed_up+="|$1|"
}

# Into a file only you can read, from stdin.
write_private() {
  install -d "$(dirname "$1")"
  (umask 077 && cat >"$1.new") && chmod 600 "$1.new" && mv "$1.new" "$1"
}
private_ok() { [[ -s $1 && $(stat -c %a "$1") == 600 ]]; }

# A service from this clone is installed, and as this clone has it? Only the
# files the tools/install-* scripts install count (as tools/omarock-sources).
installed_commit() { cat "$share/$1/INSTALLED" 2>/dev/null; }
installs() {  # DIR: its files that get installed
  case $1 in
    spotify) echo omarock-spotify.py soloist_ws.py spotify_web.py spotify_mpris.py omarock-soloist.service omarock-spotify.service ;;
    sxm) echo omarock-sxm.py omarock-sxm.service ;;
    audio) echo omarock-bus.conf omarock-guard.py omarock-players.conf omarock-bus.service omarock-guard.service ;;
  esac
}
up_to_date() {  # DIR (audio, spotify, sxm): the installed copy matches HEAD's files
  local c f paths=()
  c=$(installed_commit "$1") && [[ -n $c ]] || return 1
  for f in $(installs "$1"); do paths+=("$1/$f"); done
  git -C "$repo" diff --quiet "$c" HEAD -- "${paths[@]}" 2>/dev/null
}

# ---- 0. Before anything ----

preflight() {
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'
    exit 0
  fi
  [[ $EUID != 0 ]] || { echo "Run ./install as yourself, not root: it asks for sudo when it needs it."; exit 1; }
  command -v omarchy >/dev/null || { echo "omarock is a plugin for Omarchy's bar, and Omarchy isn't here."; exit 1; }
  command -v pacman >/dev/null || { echo "This installer uses pacman (Arch)."; exit 1; }
  git -C "$repo" rev-parse --verify -q HEAD >/dev/null || {
    echo "Run ./install from a git clone of omarock (git clone https://github.com/marcewing/omarock)."; exit 1; }
  if [[ -z $answers ]]; then
    [[ -t 0 && -t 1 ]] || { echo "Run ./install in a terminal: it asks questions."; exit 1; }
    command -v gum >/dev/null || { echo "The installer needs gum (Omarchy's prompts): sudo pacman -S gum"; exit 1; }
  fi
  # Omarchy's commands need the desktop session's environment, which a bare
  # ssh login lacks.
  local k v
  while IFS='=' read -r k v; do
    case $k in LANG|OMARCHY_PATH|WAYLAND_DISPLAY|HYPRLAND_INSTANCE_SIGNATURE|XDG_CURRENT_DESKTOP|DISPLAY)
      [[ -z ${!k:-} ]] && export "$k=$v" ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null)
}

welcome() {
  local v
  v=$(manifest_version "$repo/manifest.json")
  printf '\n%somarock %s%s: a music player for the Omarchy bar\n\n' "$bold" "$v" "$reset"
  explain "This sets up your own music and the radio: mpd (which plays the music), then omarock on the bar. It shows each command before running it, and asks before it changes anything. Run it again whenever you like: what's done is checked and skipped."
  explain "Spotify, SiriusXM and Apple Music come afterwards, each from omarock's settings, if you want them."
}
declare -A done_=()

# ---- 1. mpd ----

step_mpd() {
  step "mpd"
  local need=() p conf music v
  for p in mpd mpd-mpris mpc; do pacman -Q "$p" >/dev/null 2>&1 || need+=("$p"); done
  if ((${#need[@]})); then
    explain "omarock is a client for mpd, which plays the music and keeps the queue and playlists. mpc is its command line, and mpd-mpris passes the media keys to it. All three come from Arch's own repositories."
    confirm "Install ${need[*]} with pacman?" || { bad "omarock can't play anything without mpd."; stopped; }
    run sudo pacman -S --needed --noconfirm "${need[@]}" || stopped
  fi
  v=$(mpd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
  if [[ $(printf '%s\n0.24\n' "$v" | sort -V | head -1) != 0.24 ]]; then bad "mpd $v is too old: omarock needs 0.24 or later."; stopped; fi
  ok "mpd $v, mpc and mpd-mpris are installed"
  if systemctl is-active --quiet mpd 2>/dev/null; then
    note "mpd also runs as a system service. This sets up mpd as your own (user) service, which is what Omarchy's media keys expect."
  fi

  # The config: the music, and places for the database, playlists and state.
  # Without playlist_directory mpd turns stored playlists off, and with them
  # omarock's playlists and radio favourites.
  conf=$(mpd_conf)
  local changed=false new_music=false lines=()
  if [[ ! -f $conf ]]; then
    explain "mpd needs a config: where your music is, and where to keep its database, playlists and state."
    music=$(ask "Where's your music?" "$(xdg-user-dir MUSIC 2>/dev/null || echo "$HOME/Music")") || exit 1
    music=${music/#\~/$HOME}
    [[ -d $music ]] || note "$music isn't there now; mpd will find the music once it is."
    [[ $music == "$HOME"/* ]] && music="~/${music#"$HOME"/}"
    lines=("music_directory     \"$music\"")
  else
    ok "mpd's config: $conf"
    # For most, this is their first meeting with mpd: say where it finds the
    # music, and offer another folder.
    music=$(conf_value "$conf" music_directory)
    [[ -n $music ]] || music=$(xdg-user-dir MUSIC 2>/dev/null || echo "$HOME/Music")
    music=${music/#\~/$HOME}
    explain "mpd finds your music in $music."
    if ! confirm "Keep that as your music folder?"; then
      local new
      new=$(ask "Where's your music?" "$music") || exit 1
      new=${new/#\~/$HOME}
      if [[ -n $new && $new != "$music" ]]; then
        [[ -d $new ]] || note "$new isn't there now; mpd will find the music once it is."
        backup "$conf"
        set_conf_value "$conf" music_directory "$([[ $new == "$HOME"/* ]] && echo "~/${new#"$HOME"/}" || echo "$new")"
        ok "mpd's music folder is now $new"
        changed=true new_music=true
      fi
    fi
  fi
  local key path
  for key in playlist_directory db_file state_file sticker_file; do
    [[ -n $(conf_value "$conf" "$key") ]] && continue
    case $key in
      playlist_directory) path="~/.local/share/mpd/playlists" ;;
      db_file) path="~/.local/share/mpd/database" ;;
      state_file) path="~/.local/state/mpd/state" ;;
      sticker_file) path="~/.local/share/mpd/sticker.sql" ;;
    esac
    lines+=("$(printf '%-19s "%s"' "$key" "$path")")
  done

  # The socket. Omarchy's bar (Quickshell) can only open unix sockets, not
  # mpd's TCP port, so mpd listens on one, and on TCP for this machine only
  # (as before, for mpc and ncmpcpp) if it had no other address.
  mpd_socket=$(setting socket "")
  [[ -z $mpd_socket ]] && mpd_socket=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mpd/socket
  local other dropin_dir=$units/mpd.service.d need_dropin=false
  other=$(grep -E '^[[:space:]]*bind_to_address[[:space:]]+"(/|~/)' "$conf" 2>/dev/null | head -1 | cut -d'"' -f2)
  other=${other/#\~/$HOME}
  if [[ -n $other && $other != "$mpd_socket" ]]; then
    ok "mpd listens on $other; omarock will use it (its socket setting)"
    mpd_socket=$other
    pending[socket]=$(jq -cn --arg s "$other" '$s')
  elif [[ -z $other ]] && ! mpd_answers; then
    # A blank line after what this adds above it (an existing file gets one anyway).
    ((${#lines[@]})) && lines+=("")
    lines+=("# omarock: a unix socket (Omarchy's bar can't use TCP)")
    lines+=("bind_to_address     \"$mpd_socket\"")
    grep -qE '^[[:space:]]*bind_to_address' "$conf" 2>/dev/null || lines+=("bind_to_address     \"localhost\"")
  fi
  # mpc, here and in the commands shown, uses omarock's socket.
  export MPD_HOST=$mpd_socket
  if [[ $mpd_socket == "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mpd/"* ]] && ! active mpd.socket \
     && ! grep -qs '^RuntimeDirectory=mpd' "$dropin_dir"/*.conf; then
    need_dropin=true
  fi

  if ((${#lines[@]})) || $need_dropin; then
    echo
    if ((${#lines[@]})); then
      if [[ -f $conf ]]; then explain "This adds to $conf:"; else explain "This makes $conf:"; fi
      printf '    %s\n' "${lines[@]}"
    fi
    $need_dropin && explain "and a systemd drop-in, $dropin_dir/runtime-dir.conf, that makes the socket's folder."
    confirm "Make these changes?" || { bad "omarock needs mpd's socket and playlists."; stopped; }
    if ((${#lines[@]})); then
      backup "$conf"
      install -d "$(dirname "$conf")"
      { [[ -s $conf ]] && echo; printf '%s\n' "${lines[@]}"; } >>"$conf"
      ok "wrote $conf"
      changed=true
    fi
    if $need_dropin; then
      install -d "$dropin_dir"
      printf '# omarock: makes $XDG_RUNTIME_DIR/mpd for mpd'"'"'s socket\n[Service]\nRuntimeDirectory=mpd\n' >"$dropin_dir/runtime-dir.conf"
      ok "wrote $dropin_dir/runtime-dir.conf"
      run systemctl --user daemon-reload
      changed=true
    fi
  fi
  mkdir -p ~/.local/share/mpd/playlists ~/.local/state/mpd

  # Running, and answering on the socket.
  if active mpd.socket && ! active mpd; then
    :  # socket activation starts mpd on the first connection
  elif active mpd; then
    if $changed; then
      confirm "Restart mpd to use its new config? Anything playing stops for a moment." && run systemctl --user restart mpd
    fi
  else
    run systemctl --user enable --now mpd || { bad "mpd didn't start: journalctl --user -u mpd"; stopped; }
  fi
  systemctl --user is-enabled --quiet mpd 2>/dev/null || active mpd.socket || run systemctl --user enable mpd
  local i
  for ((i = 0; i < 40; i++)); do mpd_answers && break; sleep 0.5; done
  if mpd_answers; then ok "mpd answers on $mpd_socket"; else bad "mpd doesn't answer on $mpd_socket: journalctl --user -u mpd"; stopped; fi
  local songs
  $new_music && run mpc --quiet update
  songs=$(mpc stats 2>/dev/null | awk '/^Songs:/ {print $2}')
  if mpc status 2>/dev/null | grep -q '^Updating DB'; then
    ok "mpd is reading your music now ($songs songs so far); it carries on in the background"
  elif [[ ${songs:-0} == 0 ]]; then
    note "mpd's library is empty."
    confirm "Have mpd read your music folder now (mpc update)?" && run mpc --quiet update
  else
    ok "mpd knows $songs songs (after adding music: mpc update)"
  fi

  # The media keys: mpd-mpris exits whenever mpd restarts, and its unit
  # doesn't bring it back; a drop-in does.
  local mpris_dir=$units/mpd-mpris.service.d
  if [[ ! -f $mpris_dir/follow-mpd.conf ]]; then
    explain "mpd-mpris passes the media keys to mpd. It exits whenever mpd restarts and stays down; a drop-in ($mpris_dir/follow-mpd.conf) brings it back."
    if confirm "Add it?"; then
      install -d "$mpris_dir"
      printf '# omarock: follow mpd, and come back after it restarts\n[Unit]\nPartOf=mpd.service\n\n[Service]\nRestart=always\nRestartSec=3\n' >"$mpris_dir/follow-mpd.conf"
      ok "wrote $mpris_dir/follow-mpd.conf"
      run systemctl --user daemon-reload
    fi
  fi
  if ! active mpd-mpris || ! systemctl --user is-enabled --quiet mpd-mpris 2>/dev/null; then
    run systemctl --user enable --now mpd-mpris
  fi
  active mpd-mpris && ok "mpd-mpris runs (the media keys)" || note "mpd-mpris isn't running: journalctl --user -u mpd-mpris"
}

# ---- 2. The plugin ----

loaded_since() {  # TIME [VERSION]: the shell has logged omarock (that version) loading since TIME
  journalctl --user --since "@$1" --no-pager 2>/dev/null | grep -q "omarock ${2:-.*} loaded"
}
plugin_known() { omarchy plugin list --json 2>/dev/null | jq -e --arg id "$plugin_id" 'any(.[]; .id == $id)' >/dev/null; }

step_plugin() {
  step "The bar plugin"
  local here installed src section t0
  here=$(manifest_version "$repo/manifest.json")
  if [[ -f $plugin_dir/manifest.json ]]; then
    installed=$(manifest_version "$plugin_dir/manifest.json")
    ok "omarock $installed is installed ($plugin_dir)"
    if newer "$here" "$installed"; then
      if confirm "This clone has omarock $here. Update the plugin?"; then
        run omarchy plugin update "$plugin_id" --yes
        installed=$(manifest_version "$plugin_dir/manifest.json")
        if [[ $installed != "$here" ]]; then
          bad "the plugin is still $installed: its source ($(git -C "$plugin_dir" remote get-url origin 2>/dev/null)) didn't bring $here"
        else
          explain "Omarchy's shell has to restart to load it. That restarts every bar plugin, which takes a second."
          if confirm "Restart the shell now?"; then
            t0=$(date +%s)
            run omarchy restart shell >/dev/null 2>&1
            if wait_until "Waiting for the bar…" 30 loaded_since "$t0" "$here"; then
              ok "omarock $here loaded"
            else
              note "the bar hasn't said it loaded omarock $here yet: journalctl --user -b | grep omarock"
            fi
          fi
        fi
      fi
    fi
    if ! grep -q "\"$plugin_id\"" "$shelljson" 2>/dev/null; then
      confirm "omarock isn't on the bar. Put it there?" && run omarchy plugin enable "$plugin_id"
    fi
    return
  fi
  # From where this clone came from, so `omarchy plugin update` follows it;
  # a clone with no remote gives its own folder.
  src=$(git -C "$repo" remote get-url origin 2>/dev/null)
  [[ -z $src || $src == /* ]] && src="file://$repo"
  explain "omarock is added from $src, as Omarchy adds any plugin. Later, omarchy plugin update $plugin_id updates it."
  section=$(choose "Where on the bar?" left left "On the left" center "In the middle" right "On the right") || exit 1
  confirm "Add omarock to the bar?" || stopped
  # omarock's own folder, before omarock loads: it watches the files there,
  # and can't watch a folder that doesn't exist yet.
  install -d "$config"
  t0=$(date +%s)
  run omarchy plugin add "$src" --yes || stopped
  wait_until "Waiting for Omarchy to find it…" 15 plugin_known
  run omarchy plugin enable "$plugin_id" --section "$section" || stopped
  if wait_until "Waiting for the bar to load omarock…" 30 loaded_since "$t0" "$here"; then
    ok "omarock $here is on the bar"
  else
    note "the bar hasn't said it loaded omarock yet: journalctl --user -b | grep omarock"
  fi
}

# ---- 3. The radio's local stations ----

step_radio() {
  step "Internet radio"
  local state
  state=$(setting radioState "")
  [[ -z $state && -f $config/radio.json ]] && state=$(jq -r '.state // empty' "$config/radio.json" 2>/dev/null)
  if [[ -n $state ]]; then ok "local stations from $state"; done_[radio]=1; return; fi
  explain "Radio comes from Radio Browser, a free directory of stations; mpd plays them. With your US state, the list starts with your local stations."
  state=$(ask "Your US state (Enter to skip):" "" "Maine") || exit 1
  [[ -n $state ]] && pending[radioState]=$(jq -cn --arg s "$state" '$s')
  done_[radio]=1
}

# ---- 4. The audio bus ----

step_bus() {
  step "omarock's sound output"
  local pin out default conf vol
  conf=$(mpd_conf)
  if [[ -f $share/audio/omarock-bus.conf ]]; then
    pin=$(grep -o 'target.object = "[^"]*"' "$share/audio/omarock-bus.conf" | cut -d'"' -f2)
    ok "installed, playing only into $pin"
    if ! up_to_date audio; then
      confirm "This clone has a newer version of it. Update it (same output)?" && run "$repo/tools/install-audio" --start
    fi
  else
    explain "Everything omarock plays (mpd, Spotify) goes into one output you pick, with one volume. It never moves to another output: if yours goes away, omarock waits, silent. (Inside, it's a PipeWire bus: audio/README.md.)"
    explain "That matters if some outputs must never carry music: a radio transmitter's audio interface, say, or a TV in another room. Pick the output for your speakers or headphones."
    default=$(pactl get-default-sink 2>/dev/null)
    local name desc args=()
    while IFS=$'\t' read -r name desc; do
      [[ $name == omarock || -z $name ]] && continue
      args+=("$name" "$desc ($name)")
    done < <(pactl -f json list sinks 2>/dev/null | jq -r '.[] | [.name, .description] | @tsv')
    if ((${#args[@]} == 0)); then bad "PipeWire lists no outputs."; return 1; fi
    out=$(choose "Which output should omarock play into?" "$default" "${args[@]}") || exit 1
    [[ -n $out ]] || return 1
    confirm "omarock will play only into $out. Go on?" || return 1
    run "$repo/tools/install-audio" --start --output "$out" || return 1
  fi

  # mpd plays into the bus, with no volume of its own: the bus's is the volume.
  if grep -qE '^[[:space:]]*target[[:space:]]+"omarock"' "$conf" 2>/dev/null; then
    ok "mpd plays into it"
  else
    explain "mpd has to play into it. This puts a new audio_output in $conf, and comments out the ones there (to go back: audio/README.md):"
    printf '    %s\n' 'audio_output {' '    type        "pipewire"' '    name        "omarock"' '    target      "omarock"' '    mixer_type  "none"' '}'
    confirm "Change mpd's output, and restart mpd?" || return 1
    # The bus starts at mpd's volume now, since mpd's own goes to full.
    vol=$(mpc volume 2>/dev/null | grep -oE '[0-9]+' | head -1)
    wait_until "Waiting for it to start…" 15 "$repo/tools/omarock-volume" \
      && run "$repo/tools/omarock-volume" "${vol:-40}" >/dev/null
    backup "$conf"
    python3 -I - "$conf" <<'PY' || return 1
import re, sys
path = sys.argv[1]
out, inside = [], False
for line in open(path).read().splitlines():
    if not inside and re.match(r'\s*audio_output\b', line):
        out.append("# omarock: mpd plays into the bus now; this was the output before")
        inside = True
    if inside:
        out.append("# " + line)
        if re.match(r'\s*\}', line):
            inside = False
        continue
    out.append(line)
block = ['', 'audio_output {', '    type        "pipewire"', '    name        "omarock"',
         '    target      "omarock"', '    mixer_type  "none"', '}']
open(path + ".new", "w").write("\n".join(out + block) + "\n")
PY
    mv "$conf.new" "$conf"
    run systemctl --user restart mpd
    local i
    for ((i = 0; i < 40; i++)); do mpd_answers && break; sleep 0.5; done
    if mpc outputs 2>/dev/null | grep -q "(omarock)"; then ok "mpd plays into it"; else bad "mpd's output isn't omarock's: journalctl --user -u mpd"; return 1; fi
  fi
  ok "omarock's volume knob sets its volume now (mpc volume no longer applies: tools/omarock-volume)"
  soloist_follow_bus
  done_[bus]=1
}

# ---- 5. Spotify ----

sp_health() { health http://127.0.0.1:8730; }
soloist_age() {  # days since the installed Soloist was built, or nothing
  local built
  built=$("$HOME/.local/lib/omarock-soloist/soloist" --version 2>/dev/null | grep -oE '\(20[0-9]{6}\)' | tr -d '()')
  [[ -n $built ]] && echo $((($(date +%s) - $(date -d "$built" +%s)) / 86400))
}
sp_paired() { sp_health | jq -e '.soloist.loggedIn' >/dev/null; }
sp_signed_in() { sp_health | jq -e '.web.signedIn' >/dev/null; }
sp_up() { [[ -n $(sp_health) ]]; }
added_rules=()
cleanup_firewall() {
  local r
  for r in "${added_rules[@]}"; do run sudo ufw delete allow "$r" >/dev/null; done
  added_rules=()
}
# How this run went, into setup.json for omarock's settings: running while it
# runs, then done, stopped (Ctrl-C, the terminal closed) or failed.
record() {  # RESULT [EXIT CODE]
  [[ -n $flow ]] || return 0
  install -d "$state_dir"
  jq -n --arg piece "$flow" --arg action "$action" --arg result "$1" --argjson code "${2:-0}" \
    --argjson at "$(date +%s)" --argjson pid $$ \
    '{piece: $piece, action: $action, result: $result, code: $code, at: $at, pid: $pid}' \
    >"$state_dir/setup.json.new" && mv "$state_dir/setup.json.new" "$state_dir/setup.json"
}
# However the installer ends (done, stopped, Ctrl-C during a command, the
# terminal closed), the pairing's firewall rules come out again, and
# setup.json says how it ended.
finish() {  # EXIT CODE
  cleanup_firewall
  [[ -z $asked ]] || rm -f "$asked"
  case $1 in 0) record done 0 ;; 129 | 130 | 143) record stopped "$1" ;; *) record failed "$1" ;; esac
}
trap 'finish $?' EXIT
trap 'exit 130' INT
trap 'exit 129' HUP
trap 'exit 143' TERM

step_spotify() {
  step "Spotify"
  explain "Spotify plays here through Soloist, Spotify's own player (a Spotify Connect speaker named after this machine). omarock-spotify drives it, and searches through Spotify's Web API. You need Spotify Premium."
  local id
  if [[ -f $config/spotify.json ]] && jq -e '.clientId | length > 0' "$config/spotify.json" >/dev/null 2>&1; then
    ok "the developer app: $config/spotify.json"
  else
    explain "First, a Spotify developer app of your own (free): at developer.spotify.com/dashboard, create an app with the redirect URI http://127.0.0.1:8730/callback, and tick Web API. Its Client ID goes in omarock's config."
    if [[ -z $answers ]] && confirm "Open the dashboard in your browser?"; then xdg-open https://developer.spotify.com/dashboard >/dev/null 2>&1 & fi
    while :; do
      id=$(ask "The app's Client ID (Enter to stop here):" "" "32 letters and digits") || exit 1
      [[ -z $id ]] && return 1
      [[ $id =~ ^[0-9a-fA-F]{32}$ ]] && break
      bad "A Client ID is 32 letters and digits."
    done
    install -d "$config"
    jq -n --arg id "$id" '{clientId: $id, redirectUri: "http://127.0.0.1:8730/callback"}' >"$config/spotify.json"
    ok "wrote $config/spotify.json"
  fi
  if private_ok "$config/soloist-key"; then
    ok "the Soloist key: $config/soloist-key"
  else
    explain "Then the Soloist key, from the same dashboard. It goes into $config/soloist-key, readable only by you, and isn't shown as you type."
    local key
    key=$(secret "The Soloist key (Enter to stop here):") || exit 1
    [[ -z $key ]] && return 1
    printf '%s\n' "$key" | write_private "$config/soloist-key"
    key=""
    ok "saved the Soloist key"
  fi
  # Soloist builds stop working 90 days after they're made: fetch one only
  # when there's none, or this one is getting old.
  local age
  age=$(soloist_age)
  if [[ -z $age || $age -ge 90 ]]; then
    [[ -n $age ]] && note "Soloist's build is $age days old, and has stopped working."
    run "$repo/tools/update-soloist" || { bad "couldn't fetch Soloist from Spotify"; return 1; }
  elif ((age >= 60)); then
    explain "Soloist's build is $age days old; builds stop working at 90."
    if confirm "Fetch the latest from Spotify?"; then run "$repo/tools/update-soloist"; fi
  else
    ok "Soloist, built $age days ago (builds last 90 days)"
  fi
  if [[ ! -f $share/spotify/INSTALLED ]]; then
    run "$repo/tools/install-spotify" --start || return 1
  elif ! up_to_date spotify && confirm "This clone has a newer omarock-spotify. Update it?"; then
    run "$repo/tools/install-spotify" --start || return 1
  elif ! active omarock-spotify; then
    run systemctl --user start omarock-soloist omarock-spotify
  fi
  wait_until "Waiting for omarock-spotify…" 20 sp_up || { bad "omarock-spotify doesn't answer: journalctl --user -u omarock-spotify -u omarock-soloist"; return 1; }
  ok "omarock-spotify and Soloist run"

  # Pairing: once, from the Spotify app on a phone or computer on this network.
  if sp_paired; then
    ok "Soloist is signed in to your account"
  else
    explain "Now pair Soloist with your account, once: in Spotify on your phone or computer, on this network, open Connect to a device, pick $(hostname), and play something."
    if grep -qs '^ENABLED=yes' /etc/ufw/ufw.conf; then
      local port
      port=$(ss -ltnpH 2>/dev/null | awk '/"soloist"/ && $4 !~ /^127\./ {n = split($4, a, ":"); print a[n]; exit}')
      if [[ -z $port ]]; then
        note "Soloist isn't listening for Spotify apps: journalctl --user -u omarock-soloist"
      else
        explain "Your firewall (ufw) hides Soloist from the network. This opens its port ($port/tcp) and mDNS (5353/udp) while you pair, and closes them again afterwards."
      fi
      if [[ -n $port ]] && confirm "Open them for the pairing (sudo ufw)?"; then
        local rule
        for rule in "$port/tcp" 5353/udp; do
          if ! sudo ufw status | grep -qE "^${rule}[[:space:]]"; then
            run sudo ufw allow "$rule" >/dev/null && added_rules+=("$rule")
          fi
        done
      fi
    fi
    if wait_until "Waiting for the pairing… (Ctrl-C to do it later)" 600 sp_paired; then
      ok "Soloist is signed in to your account"
    else
      note "not paired yet; pair it whenever you like (spotify/README.md, step 5)"
    fi
    cleanup_firewall
  fi
  if sp_signed_in; then
    ok "signed in to Spotify's Web API"
  else
    explain "Last, sign in to Spotify's Web API (for search and your library). This opens Spotify's sign-in page in your browser."
    if confirm "Sign in now?"; then
      run "$repo/tools/omarock-sp" login
      wait_until "Waiting for the sign-in… (Ctrl-C to do it later)" 300 sp_signed_in \
        && ok "signed in to Spotify's Web API" || note "not signed in yet: tools/omarock-sp login"
    fi
  fi
  done_[spotify]=1
}

# ---- 6. SiriusXM ----

sxm_health() { health http://127.0.0.1:8720; }
sxm_signed_in() { sxm_health | jq -e '.account and .loggedIn' >/dev/null; }
sxm_account_set() {
  python3 -I -c '
import json, sys
d = json.load(open(sys.argv[1]))
sys.exit(0 if d.get("username") and d.get("password") and d["username"] != "you@example.com" else 1)' "$config/siriusxm.json" 2>/dev/null
}

step_sxm() {
  step "SiriusXM"
  if [[ ! -f $share/sxm/INSTALLED ]]; then
    explain "omarock-sxm plays SiriusXM's live channels through mpd. It's unofficial: it signs in as SiriusXM's web player does. SiriusXM's terms forbid that, so your account could be limited or closed, and it may stop working whenever SiriusXM changes its player (sxm/README.md, \"Read this first\")."
    confirm "Set it up anyway?" no || return 1
  fi
  if [[ ! -f $share/sxm/INSTALLED ]]; then
    run "$repo/tools/install-sxm" --start || return 1
  elif ! up_to_date sxm && confirm "This clone has a newer omarock-sxm. Update it?"; then
    run "$repo/tools/install-sxm" --start || return 1
  elif ! active omarock-sxm; then
    run systemctl --user start omarock-sxm
  fi
  local user pass err again=false
  while :; do
    if sxm_account_set && ! $again; then
      ok "the account: $config/siriusxm.json"
    else
      explain "Your SiriusXM login goes into $config/siriusxm.json, readable only by you. The password isn't shown as you type."
      user=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1])).get("username", ""))' "$config/siriusxm.json" 2>/dev/null)
      user=$(ask "SiriusXM email or username (Enter to stop here):" "$user") || exit 1
      [[ -z $user ]] && return 1
      pass=$(secret "SiriusXM password:") || exit 1
      printf '%s\0%s' "$user" "$pass" | python3 -I -c '
import json, sys
u, p = sys.stdin.read().split("\0", 1)
print(json.dumps({"username": u, "password": p}))' | write_private "$config/siriusxm.json"
      pass=""
      ok "saved the account"
      run systemctl --user restart omarock-sxm
    fi
    if wait_until "Signing in to SiriusXM…" 45 sxm_signed_in; then
      ok "omarock-sxm is signed in"
      break
    fi
    err=$(sxm_health | jq -r '.error // empty')
    bad "omarock-sxm isn't signed in${err:+: $err}"
    explain "A wrong login, most likely. An entitlement that's \"revoked\" means the subscription has no streaming. You can also change the login later, in omarock's settings."
    confirm "Enter the SiriusXM login again?" || return 1
    again=true
  done
  done_[sxm]=1
}

# ---- 7. Apple Music ----

bridge_status() {  # BRIDGE TOKENFILE: the HTTP status of an authenticated request
  printf 'header = "Authorization: Bearer %s"\n' "$(<"$2")" \
    | curl -s -m 5 -o /dev/null -w '%{http_code}' -K - "$1/v1/status" 2>/dev/null
}

step_apple() {
  step "Apple Music"
  explain "Apple Music plays on a Mac, through omarock's bridge: an app built there with your own Apple Developer membership (bridge/README.md): clone omarock on the Mac and run ./install there too. Its sound comes here as a stream mpd plays. Both machines need to reach each other, over Tailscale, say."
  local bridge="" stream="" h
  if [[ -f $config/apple.json ]]; then
    bridge=$(jq -r '.bridge // empty' "$config/apple.json")
    stream=$(jq -r '.stream // empty' "$config/apple.json")
  fi
  if [[ -n $bridge ]] && h=$(health "$bridge") && [[ -n $h ]]; then
    ok "the bridge answers at $bridge"
  else
    [[ -n $bridge ]] && note "the bridge at $bridge doesn't answer"
    confirm "Is the bridge built and running on your Mac?" || {
      note "Set it up on the Mac first (clone omarock there and run ./install), then run ./install here again."; return 1; }
    local args=() host ip addr
    if command -v tailscale >/dev/null; then
      # The address first: a Mac's name usually has spaces ("Marc's M2 Pro").
      while read -r ip host; do args+=("$ip" "$host ($ip)"); done < <(tailscale status --json 2>/dev/null \
        | jq -r '.Peer[]? | select(.OS == "macOS") | "\(.TailscaleIPs[0]) \(.HostName)"')
    fi
    while :; do
      addr=other
      if ((${#args[@]})); then addr=$(choose "Which Mac?" "" "${args[@]}" other "Another address…") || exit 1; fi
      if [[ $addr == other ]]; then addr=$(ask "The Mac's address (Enter to stop here):" "" "100.64.0.10 or my-mac") || exit 1; fi
      [[ -z $addr ]] && return 1
      bridge="http://$addr:8710"
      h=$(health "$bridge")
      [[ -n $h ]] && break
      bad "nothing answers at $bridge. Is the bridge running, and can this machine reach the Mac?"
    done
    ok "the bridge answers at $bridge"
    stream=$(jq -r '.stream // empty' <<<"$h")
    [[ -n $stream ]] || stream="http://$addr:8000/omarock.ogg"
    install -d "$config"
    jq -n --arg b "$bridge" --arg s "$stream" '{bridge: $b, stream: $s}' >"$config/apple.json"
    ok "wrote $config/apple.json"
  fi
  if [[ -n $h ]] && ! jq -e '.authorized' >/dev/null <<<"$h"; then
    note "the bridge may not use Apple Music yet: allow it on the Mac (System Settings, Privacy & Security, Media & Apple Music)"
  fi

  local tokenfile
  tokenfile=$(setting appleTokenFile "$config/bridge-token")
  tokenfile=${tokenfile/#\~/$HOME}
  if private_ok "$tokenfile" && [[ $(bridge_status "$bridge" "$tokenfile") == 200 ]]; then
    ok "the bridge's token: $tokenfile"
  else
    explain "omarock needs the bridge's token, which the bridge made on the Mac. It goes into $tokenfile, readable only by you."
    local how token code user host
    how=$(choose "How should it come over?" paste \
      paste "I'll paste it (on the Mac: pbcopy < ~/Library/Application\ Support/omarock-bridge/token)" \
      ssh "Copy it with scp (the Mac's Remote Login must be on)") || exit 1
    if [[ $how == ssh ]]; then
      user=$(ask "Your user name on the Mac:" "$USER") || exit 1
      host=${bridge#http://}
      host=${host%:*}
      (umask 077 && run scp "$user@$host:Library/Application Support/omarock-bridge/token" "$tokenfile.new") || return 1
      tr -d '\n' <"$tokenfile.new" | write_private "$tokenfile"
      rm -f "$tokenfile.new"
    else
      token=$(secret "The bridge's token:") || exit 1
      [[ -z $token ]] && return 1
      printf '%s' "$token" | write_private "$tokenfile"
      token=""
    fi
    code=$(bridge_status "$bridge" "$tokenfile")
    if [[ $code == 200 ]]; then ok "the bridge accepts the token"; else bad "the bridge refused the token (HTTP $code)"; return 1; fi
  fi
  [[ $tokenfile == "$config/bridge-token" ]] || pending[appleTokenFile]=$(jq -cn --arg s "$tokenfile" '$s')

  # Smooth playback: the patches (patches/README.md). Without the libFLAC
  # one, omarock reconnects mpd after each change (appleRejoin), a short stutter.
  local pid flac=false
  pid=$(systemctl --user show -p MainPID --value mpd 2>/dev/null)
  if [[ -n $pid && $pid != 0 ]] && grep -q omarock-flac "/proc/$pid/maps" 2>/dev/null; then flac=true; fi
  if $flac; then
    ok "mpd uses the patched libFLAC"
    [[ $(setting appleRejoin true) == true ]] && pending[appleRejoin]=false
  else
    explain "For smooth playback, mpd needs a fix to libFLAC that isn't in Arch's yet (patches/README.md). Without it, mpd falls behind the Mac, and omarock catches it up after each change, with a short stutter. This builds the fixed library for mpd only (a few minutes; needs cmake and ninja)."
    if confirm "Build the patched libFLAC?" no; then
      run sudo pacman -S --needed --noconfirm base-devel cmake ninja git \
        && run "$repo/tools/build-libflac" \
        && install -d "$units/mpd.service.d" \
        && printf '# omarock: the patched libFLAC, for mpd only (patches/README.md)\n[Service]\nEnvironment=LD_LIBRARY_PATH=%%h/.local/lib/omarock-flac\n' >"$units/mpd.service.d/omarock-flac.conf" \
        && run systemctl --user daemon-reload \
        && run systemctl --user restart mpd \
        && ok "mpd uses the patched libFLAC" && pending[appleRejoin]=false
    fi
  fi
  if [[ ! -f $units/mpd-mpris.service.d/omarock-mpris.conf ]]; then
    explain "mpd-mpris also asks mpd for the stream's cover art at every play and pause, which holds mpd for seconds. A patched mpd-mpris doesn't (a minute to build; needs Go)."
    if confirm "Build the patched mpd-mpris?" no; then
      run sudo pacman -S --needed --noconfirm go git \
        && run "$repo/tools/build-mpd-mpris" \
        && printf '# omarock: mpd-mpris, patched (patches/README.md)\n[Service]\nExecStart=\nExecStart=%%h/.local/lib/omarock-mpris/mpd-mpris -no-instance\n' >"$units/mpd-mpris.service.d/omarock-mpris.conf" \
        && run systemctl --user daemon-reload \
        && run systemctl --user restart mpd-mpris \
        && ok "mpd-mpris is the patched one"
    fi
  fi
  done_[apple]=1
}

# ---- Last: the switches ----

set_setting() {  # KEY JSON: one of omarock's settings, into its settings file
  local now file=$config/settings.json
  now=$(setting "$1" "")
  [[ $now == "$(jq -r 'if type == "string" then . else tostring end' <<<"$2")" ]] && return 0
  install -d "$config"
  { jq --arg k "$1" --argjson v "$2" '.[$k] = $v' "$file" 2>/dev/null || jq -n --arg k "$1" --argjson v "$2" '{($k): $v}'; } \
    >"$file.new" && mv "$file.new" "$file"
  printf '  %s%s: %s%s\n' "$dim" "$1" "$(jq -r . <<<"$2")" "$reset"
}

unset_setting() {  # KEY...: out of omarock's settings file, back to their defaults
  local file=$config/settings.json k
  [[ -f $file ]] || return 0
  for k; do
    jq -e --arg k "$k" 'has($k)' "$file" >/dev/null 2>&1 || continue
    jq --arg k "$k" 'del(.[$k])' "$file" >"$file.new" && mv "$file.new" "$file"
    printf '  %s%s: back to its default%s\n' "$dim" "$k" "$reset"
  done
}

# What the steps found or chose (pending), into ~/.config/omarock/settings.json,
# which the panel follows.
save_pending() {
  local k
  for k in "${!pending[@]}"; do set_setting "$k" "${pending[$k]}"; done
}

# ---- What a run sets up: local music, or one piece ----

# A piece's name as typed, as setup.json and the settings know it.
piece_name() {
  case ${1:-} in
    spotify) echo spotify ;;
    siriusxm | sxm) echo siriusxm ;;
    apple-music | apple | applemusic) echo apple-music ;;
    sound | bus | audio) echo sound ;;
    *) return 1 ;;
  esac
}
piece_title() {
  case $1 in spotify) echo Spotify ;; siriusxm) echo SiriusXM ;; apple-music) echo "Apple Music" ;; sound) echo "omarock's sound output" ;; esac
}
# The settings switch that shows a source in the panel.
piece_switch() {
  case $1 in spotify) echo spotify ;; siriusxm) echo siriusXM ;; apple-music) echo appleMusic ;; esac
}
no_piece() {
  echo "install: no such piece: ${1:-(none)}. It's one of spotify, siriusxm, apple-music or sound." >&2
  exit 2
}

# mpd, as omarock reaches it: every piece needs it. Set up first if it isn't.
local_music() {
  mpd_socket=$(setting socket "")
  [[ -z $mpd_socket ]] && mpd_socket=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mpd/socket
  export MPD_HOST=$mpd_socket
  mpd_answers && return 0
  explain "Your own music isn't set up here yet (mpd, which plays everything omarock plays), so that comes first."
  step_mpd
}

setup_local() {
  flow=local
  record running
  welcome
  step_mpd
  step_plugin
  step_radio
  save_pending
  printf '\n%sReady%s\n' "$bold" "$reset"
  explain "Click omarock in the bar (a music note until something plays). Press ? there for the keys."
  explain "For Spotify, SiriusXM or Apple Music: omarock's settings (press , in the panel) set each one up."
}

setup_piece() {
  local piece key
  piece=$(piece_name "$1") || no_piece "$1"
  flow=$piece again="./install $piece"
  record running
  printf '\n%sSetting up %s%s\n' "$bold" "$(piece_title "$piece")" "$reset"
  local_music
  case $piece in
    spotify) step_spotify ;;
    siriusxm) step_sxm ;;
    apple-music) step_apple ;;
    sound) step_bus ;;
  esac || { printf '\n%s isn'"'"'t set up yet. Run %s again to carry on.\n' "$(piece_title "$piece")" "$again"; exit 1; }
  key=$(piece_switch "$piece")
  [[ -n $key ]] && pending[$key]=true
  save_pending
  printf '\n%sReady%s\n' "$bold" "$reset"
  if [[ -n $key ]]; then
    explain "$(piece_title "$piece") is switched on: it has its button in omarock's panel. Its switch in omarock's settings turns it off and on."
  fi
}

remove_piece() {
  local piece
  piece=$(piece_name "${1:-}") || no_piece "${1:-}"
  flow=$piece action=remove again="./install --remove $piece"
  record running
  printf '\n%sTaking %s off this machine%s\n' "$bold" "$(piece_title "$piece")" "$reset"
  # mpc reaches mpd where omarock does.
  mpd_socket=$(setting socket "")
  [[ -z $mpd_socket ]] && mpd_socket=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mpd/socket
  [[ -S $mpd_socket ]] && export MPD_HOST=$mpd_socket
  case $piece in
    spotify) un_spotify keys ;;
    siriusxm) un_sxm keys ;;
    apple-music) un_apple ;;
    sound) un_bus piece ;;
  esac || { printf '\nNothing more was removed. Run %s again whenever you like.\n' "$again"; exit 1; }
}

# ---- Taking it off: ./install --uninstall ----

# What omarock set up, in reverse: the plugin, the services, the patches, the
# bus, then its changes to mpd and its own files. Each step shows what it
# removes and asks first. mpd, its packages, the music and playlists stay.

present() { local p; for p; do [[ -e $p || -L $p ]] && printf '%s\n' "$p"; done; }
listing() { local p; for p; do printf '    %s\n' "${p/#"$HOME"/\~}"; done; }
stop_units() {  # UNIT...: stop and disable those that are installed
  local u have=()
  for u; do [[ -f $units/$u.service ]] && have+=("$u.service"); done
  ((${#have[@]} == 0)) || run systemctl --user disable --now "${have[@]}"
}
mpd_back() {  # after a restart: mpd answers again
  local i
  for ((i = 0; i < 40; i++)); do mpc status >/dev/null 2>&1 && break; sleep 0.5; done
  if mpc status >/dev/null 2>&1; then ok "mpd runs"; else bad "mpd doesn't answer: journalctl --user -u mpd"; fi
}

un_plugin() {
  [[ -d $plugin_dir ]] || grep -q "\"$plugin_id\"" "$shelljson" 2>/dev/null || return 0
  step "The bar plugin"
  explain "Omarchy's own remove takes omarock off the bar, with its settings there, and deletes $plugin_dir."
  confirm "Remove the omarock plugin?" || return 0
  run omarchy plugin remove "$plugin_id" --yes
  if [[ -d $plugin_dir ]]; then bad "$plugin_dir is still there"; else ok "omarock is off the bar"; fi
}

# un_spotify, un_sxm [keys]: with keys (./install --remove), the source's
# accounts and keys go too, its switch goes off, and a no stops the run.
un_spotify() {
  local paths keys=() with=${1:-}
  [[ -n $with ]] && keys=("$config/spotify.json" "$config/soloist-key" "$config/spotify-token.json")
  mapfile -t paths < <(present "$units/omarock-spotify.service" "$units/omarock-soloist.service" "$share/spotify" \
    "$HOME/.local/lib/omarock-soloist" "$HOME/.local/share/omarock-soloist" "$HOME/.cache/omarock-soloist" "${keys[@]}")
  if ((${#paths[@]} == 0)); then
    [[ -n $with ]] && { ok "Spotify isn't set up here"; set_setting spotify false; }
    return 0
  fi
  step "Spotify"
  if [[ -n $with ]]; then
    explain "This stops omarock-spotify and Soloist, and deletes them, with Soloist's sign-in and cache, your app's Client ID, the Soloist key and the Web API's sign-in:"
  else
    explain "This stops omarock-spotify and Soloist, and deletes them, with Soloist's sign-in and cache:"
  fi
  listing "${paths[@]}"
  confirm "Remove Spotify$([[ -z $with ]] && echo "'s services")?" || { [[ -z $with ]]; return; }
  stop_units omarock-spotify omarock-soloist
  run rm -rf "${paths[@]}"
  run systemctl --user daemon-reload
  [[ -n $with ]] && set_setting spotify false
  ok "Spotify is gone from this machine"
  note "your developer app is still in Spotify's dashboard (developer.spotify.com): delete it there if you like"
  [[ -n $with ]] && note "Soloist may stay listed among your account's devices until Spotify forgets it"
  return 0
}

un_sxm() {
  local paths keys=() with=${1:-}
  # An editor's backup of the login holds it too.
  [[ -n $with ]] && keys=("$config/siriusxm.json" "$config/siriusxm.json~")
  mapfile -t paths < <(present "$units/omarock-sxm.service" "$share/sxm" "$share/sxm-venv" "${keys[@]}")
  if ((${#paths[@]} == 0)); then
    [[ -n $with ]] && { ok "SiriusXM isn't set up here"; set_setting siriusXM false; }
    return 0
  fi
  step "SiriusXM"
  if [[ -n $with ]]; then
    explain "This stops omarock-sxm and deletes it, with your SiriusXM login:"
  else
    explain "This stops omarock-sxm and deletes it:"
  fi
  listing "${paths[@]}"
  confirm "Remove $([[ -n $with ]] && echo SiriusXM || echo "the SiriusXM service")?" || { [[ -z $with ]]; return; }
  stop_units omarock-sxm
  run rm -rf "${paths[@]}"
  run systemctl --user daemon-reload
  [[ -n $with ]] && set_setting siriusXM false
  ok "SiriusXM is gone from this machine"
  return 0
}

# ./install --remove apple-music: the bridge's address and token here, and
# the patches that were for its stream. The bridge on the Mac stays.
un_apple() {
  local token paths flac mpris
  token=$(setting appleTokenFile "")
  [[ -z $token ]] && token=$config/bridge-token
  token=${token/#\~/$HOME}
  mapfile -t paths < <(present "$config/apple.json" "$token")
  mapfile -t flac < <(present "$units/mpd.service.d/omarock-flac.conf" "$HOME/.local/lib/omarock-flac")
  mapfile -t mpris < <(present "$units/mpd-mpris.service.d/omarock-mpris.conf" "$HOME/.local/lib/omarock-mpris")
  step "Apple Music"
  if ((${#paths[@]} + ${#flac[@]} + ${#mpris[@]} == 0)); then
    ok "Apple Music isn't set up here"
    set_setting appleMusic false
    return 0
  fi
  explain "This deletes the bridge's address and its token here$( ((${#flac[@]} + ${#mpris[@]})) && echo ", and omarock's patched builds for the bridge's stream: mpd and the media keys go back to Arch's own (mpd restarts, so anything playing stops for a moment)"):"
  listing "${paths[@]}" "${flac[@]}" "${mpris[@]}"
  confirm "Remove Apple Music from this machine?" || return 1
  run rm -rf "${paths[@]}" "${flac[@]}" "${mpris[@]}"
  if ((${#flac[@]} + ${#mpris[@]})); then
    rmdir "$units/mpd.service.d" "$units/mpd-mpris.service.d" 2>/dev/null
    run systemctl --user daemon-reload
    ((${#flac[@]})) && { run systemctl --user restart mpd; mpd_back; }
    ((${#mpris[@]})) && run systemctl --user restart mpd-mpris
  fi
  unset_setting appleBridge appleStream appleTokenFile appleRejoin appleIdleStop
  set_setting appleMusic false
  ok "Apple Music is gone from this machine"
  note "the bridge on your Mac stays: ./install --uninstall in omarock's clone there takes it off"
  return 0
}

# Soloist picks its output as it starts (its unit): omarock's sound output
# while that's set up, else the default output. After the sound output comes
# or goes, a Soloist playing to the wrong one restarts.
soloist_follow_bus() {
  active omarock-soloist || return 0
  local pid on=false want=false
  pid=$(systemctl --user show -p MainPID --value omarock-soloist)
  # Its command line holds the Soloist key: read, never shown.
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q -- '--pipewire-device omarock' && on=true
  [[ -f $share/audio/omarock-bus.conf ]] && want=true
  [[ $on == "$want" ]] && return 0
  explain "Spotify's player restarts, to play $($want && echo "through omarock's sound output" || echo "into your default output")."
  run systemctl --user restart omarock-soloist
}

un_patches() {
  local flac mpris
  mapfile -t flac < <(present "$units/mpd.service.d/omarock-flac.conf" "$HOME/.local/lib/omarock-flac")
  mapfile -t mpris < <(present "$units/mpd-mpris.service.d/omarock-mpris.conf" "$HOME/.local/lib/omarock-mpris")
  ((${#flac[@]} + ${#mpris[@]})) || return 0
  step "The Apple Music patches"
  if ((${#flac[@]})); then
    explain "mpd uses omarock's patched libFLAC. This deletes it and the drop-in that loads it, and restarts mpd with Arch's own (anything playing stops for a moment):"
    listing "${flac[@]}"
    if confirm "Remove the patched libFLAC, and restart mpd?"; then
      run rm -rf "${flac[@]}"
      run systemctl --user daemon-reload
      run systemctl --user restart mpd
      mpd_back
    fi
  fi
  if ((${#mpris[@]})); then
    explain "mpd-mpris runs omarock's patched build. This deletes it and its drop-in, and restarts Arch's own:"
    listing "${mpris[@]}"
    if confirm "Remove the patched mpd-mpris?"; then
      run rm -rf "${mpris[@]}"
      run systemctl --user daemon-reload
      run systemctl --user restart mpd-mpris
      ok "mpd-mpris is Arch's own again"
    fi
  fi
}

# mpd_conf_undo CONF show|write, for the bus: omarock's audio_output goes, and
# the outputs the installer commented out come back. "show" prints what comes
# back; "write" writes CONF.new.
mpd_conf_undo() {
  python3 -I - "$@" <<'PY'
import re, sys
path, mode = sys.argv[1:]
lines = open(path).read().split("\n")
out, back, i = [], [], 0
while i < len(lines):
    line = lines[i]
    if re.match(r'\s*audio_output\b', line):
        j = i
        while j < len(lines) - 1 and not re.match(r'\s*\}', lines[j]):
            j += 1
        if any(re.match(r'\s*target\s+"omarock"', l) for l in lines[i:j + 1]):
            if out and not out[-1].strip():
                out.pop()
            i = j + 1
            continue
    if line.startswith("# omarock: mpd plays into the bus now"):
        i += 1
        while i < len(lines) and lines[i].startswith("# "):
            out.append(lines[i][2:])
            back.append(lines[i][2:])
            i += 1
            if re.match(r'\s*\}', back[-1]):
                break
        continue
    out.append(line)
    i += 1
if mode == "show":
    print("\n".join(back))
else:
    open(path + ".new", "w").write("\n".join(out).rstrip("\n") + "\n")
PY
}

# un_bus [piece]: as ./install --remove sound, it warns first, a no stops the
# run, and Spotify's player follows.
un_bus() {
  local conf paths block=false back piece=${1:-}
  conf=$(mpd_conf)
  grep -qE '^[[:space:]]*target[[:space:]]+"omarock"' "$conf" 2>/dev/null && block=true
  mapfile -t paths < <(present "$units/omarock-bus.service" "$units/omarock-guard.service" "$share/audio" \
    "$HOME/.config/pipewire/client.conf.d/50-omarock-players.conf" "$config/audio-output")
  if ! $block && ((${#paths[@]} == 0)); then
    [[ -n $piece ]] && ok "omarock's sound output isn't set up here"
    return 0
  fi
  step "omarock's sound output"
  if [[ -n $piece ]]; then
    explain "Without it, omarock plays wherever your default output is, and follows it when that changes. If some output must never carry music (a radio transmitter's audio interface, say), keep it."
  fi
  if $block; then
    back=$(mpd_conf_undo "$conf" show)
    explain "mpd plays into it. This takes omarock's audio_output out of $conf, and restarts mpd."
    if [[ -n $back ]]; then
      explain "The output mpd had before comes back:"
      printf '    %s\n' "$back"
    else
      explain "No output was set aside when it went in, so mpd will use its default (PipeWire's default output). Check that's where you want music to play."
    fi
  fi
  if ((${#paths[@]})); then
    explain "It and its guard stop, and these go:"
    listing "${paths[@]}"
  fi
  if [[ -n $piece ]]; then
    confirm "Remove omarock's sound output$($block && echo ", and restart mpd")?" no || return 1
  else
    confirm "Remove omarock's sound output$($block && echo ", and restart mpd")?" || return 0
  fi
  if $block; then
    backup "$conf"
    mpd_conf_undo "$conf" write && mv "$conf.new" "$conf" && ok "wrote $conf"
  fi
  stop_units omarock-bus omarock-guard
  ((${#paths[@]} == 0)) || run rm -rf "${paths[@]}"
  run systemctl --user daemon-reload
  if $block; then
    run systemctl --user restart mpd
    mpd_back
    mpc outputs 2>/dev/null | grep '^Output' | sed 's/^/    /'
  fi
  ok "omarock's sound output is gone; mpd's own volume applies again"
  [[ -n $piece ]] && soloist_follow_bus
  return 0
}

# The unix socket step_mpd added to mpd.conf: its comment and bind_to_address
# lines. CONF show|write, as mpd_conf_undo.
mpd_socket_undo() {
  python3 -I - "$@" <<'PY'
import re, sys
path, mode = sys.argv[1:]
lines = open(path).read().split("\n")
out, gone, i = [], [], 0
while i < len(lines):
    if lines[i].startswith("# omarock: a unix socket"):
        if out and not out[-1].strip():
            out.pop()
        gone.append(lines[i])
        i += 1
        while i < len(lines) and re.match(r'\s*bind_to_address\s+"((/|~/)\S*mpd/socket|localhost)"', lines[i]):
            gone.append(lines[i])
            i += 1
        continue
    out.append(lines[i])
    i += 1
if mode == "show":
    print("\n".join(gone))
else:
    open(path + ".new", "w").write("\n".join(out).rstrip("\n") + "\n")
PY
}

un_mpd() {
  local conf gone dropins=() f
  conf=$(mpd_conf)
  gone=$([[ -f $conf ]] && mpd_socket_undo "$conf" show)
  for f in "$units/mpd.service.d/runtime-dir.conf" "$units/mpd-mpris.service.d/follow-mpd.conf"; do
    head -1 "$f" 2>/dev/null | grep -q '^# omarock:' && dropins+=("$f")
  done
  [[ -n $gone ]] || ((${#dropins[@]})) || return 0
  step "omarock's changes to mpd"
  explain "omarock also set mpd up for itself. Other mpd clients can use these too, so they stay unless you say otherwise."
  if [[ -n $gone ]]; then explain "In $conf, mpd's unix socket:"; sed 's/^/    /' <<<"$gone"; fi
  if ((${#dropins[@]})); then explain "Drop-ins (the socket's folder, and mpd-mpris following mpd):"; listing "${dropins[@]}"; fi
  confirm "Take these out too, and restart mpd?" no || { ok "kept them"; return 0; }
  if [[ -n $gone ]]; then
    backup "$conf"
    mpd_socket_undo "$conf" write && mv "$conf.new" "$conf" && ok "wrote $conf"
  fi
  ((${#dropins[@]} == 0)) || run rm -f "${dropins[@]}"
  rmdir "$units/mpd.service.d" "$units/mpd-mpris.service.d" 2>/dev/null
  run systemctl --user daemon-reload
  run systemctl --user restart mpd
  unset MPD_HOST
  mpd_back
  # Without follow-mpd.conf, mpd-mpris dies with mpd's restart and stays down.
  if systemctl --user is-enabled -q mpd-mpris 2>/dev/null; then run systemctl --user restart mpd-mpris; fi
  if [[ -n $gone ]] && ! grep -q '^[[:space:]]*bind_to_address' "$conf"; then
    note "mpd listens where it does by default now: port 6600 on every network interface, and its socket"
  fi
}

un_config() {
  local files
  [[ -d $config ]] || return 0
  step "omarock's own files"
  mapfile -t files < <(find "$config" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort)
  explain "$config holds omarock's settings, and the keys and sign-ins you gave it:"
  if ((${#files[@]})); then printf '    %s\n' "${files[@]}"; else explain "(it's empty)"; fi
  if confirm "Delete it, keys and sign-ins included?" no; then
    run rm -rf "$config"
    ok "deleted"
  else
    ok "kept $config"
  fi
}

uninstall() {
  again="./install --uninstall"
  printf '\n%sTaking omarock off this machine%s\n\n' "$bold" "$reset"
  explain "This goes through what omarock set up, in reverse: the bar plugin, the services, the patches, its sound output, then its changes to mpd and its own files. It shows what each step removes, and asks first. mpd stays, with your music, its database and playlists."
  # mpc reaches mpd where omarock did, while that's still there.
  mpd_socket=$(setting socket "")
  [[ -z $mpd_socket ]] && mpd_socket=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mpd/socket
  [[ -S $mpd_socket ]] && export MPD_HOST=$mpd_socket
  local before=$step_no backups
  un_plugin
  un_spotify
  un_sxm
  un_patches
  un_bus
  un_mpd
  un_config
  [[ -d $share ]] && rmdir "$share" 2>/dev/null
  ((step_no > before)) || ok "nothing of omarock's is set up here"
  printf '\n%sWhat stays%s\n' "$bold" "$reset"
  explain "mpd, mpc and mpd-mpris, with mpd's config, database and playlists. omarock's radio favourites are the mpd playlist \"Radio\"."
  mapfile -t backups < <(compgen -G "$(mpd_conf).before-omarock-*")
  if ((${#backups[@]})); then explain "Copies of mpd.conf from before each change:"; listing "${backups[@]}"; fi
  explain "This clone, $repo: delete it when you're done. On a Mac, the Apple Music bridge comes off with ./install --uninstall in its clone there (bridge/README.md)."
}

main() {
  preflight "$@"
  case ${1:-} in
    --uninstall) uninstall ;;
    --remove) remove_piece "${2:-}" ;;
    "") setup_local ;;
    -*) no_piece "$1" ;;
    *) setup_piece "$1" ;;
  esac
}

main "$@"; exit
