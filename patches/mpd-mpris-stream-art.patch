From b4918026007d820a048e7ca306e0e9f3849dff5d Mon Sep 17 00:00:00 2001
From: Marc Ewing <marc@riotracing.com>
Date: Tue, 20 Oct 2026 17:56:17 -0400
Subject: [PATCH 2/2] Don't ask MPD for a remote stream's album art
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

For a URI such as http://…, readpicture and albumart make MPD open the
stream and probe it, while it answers no other client. For an Ogg FLAC
stream from Icecast, MPD's ffmpeg plugin probed it for 6 to 7 seconds,
and found nothing: MPD has no art for streams. Skip the lookup for
remote URIs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016rSr6RyB719BULhakT1QHf
---
 mpd/song.go | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/mpd/song.go b/mpd/song.go
index 185ee71..ce6e214 100644
--- a/mpd/song.go
+++ b/mpd/song.go
@@ -6,6 +6,7 @@ import (
 	"os"
 	"path/filepath"
 	"strconv"
+	"strings"
 	"sync"
 
 	"github.com/fhs/gompd/v2/mpd"
@@ -79,6 +80,12 @@ func (c *Client) songFromAttrs(attr mpd.Attrs, prev *Song) (s Song, err error) {
 	if albumArtURI != "" {
 		// delete the old album art file
 		os.Remove(albumArtURI)
+		albumArtURI = ""
+	}
+	// A remote stream (http://…): MPD has no art for it, and to look, it opens
+	// the stream and probes it while every other client waits.
+	if strings.Contains(s.Path(), "://") {
+		return
 	}
 	albumArtURI = newTempFile()
 	if albumArtURI != "" {
