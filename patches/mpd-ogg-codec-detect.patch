From 42327596896a13b98eb0c1ad5409a8b3ae0308fd Mon Sep 17 00:00:00 2001
From: Marc Ewing <marc@riotracing.com>
Date: Tue, 20 Oct 2026 16:35:48 -0400
Subject: [PATCH] decoder/OggCodec: read the whole header in ogg_codec_detect()

decoder_read() returns as soon as some data is available.  If a
stream's first 41 bytes did not arrive at once (a slow server or
proxy), the short read made ogg_codec_detect() return
OGG_CODEC_UNKNOWN, so the vorbis, flac and opus plugins all declined
the stream and the ffmpeg plugin decoded it instead.  Use
decoder_read_full().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016rSr6RyB719BULhakT1QHf
---
 NEWS                             | 1 +
 src/decoder/plugins/OggCodec.cxx | 4 ++--
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/NEWS b/NEWS
index b63a0b2..dfc9f55 100644
--- a/NEWS
+++ b/NEWS
@@ -20,6 +20,7 @@ ver 0.24.17 (not yet released)
   - cue: limit the number of tracks
 * decoder
   - ffmpeg: restrict nested protocols
+  - flac, opus, vorbis: fix Ogg detection if a stream's first bytes arrive in pieces
   - gme: limit the number of subtunes in a container
   - mpg123: fix crash with empty TXXX frame
 * database
diff --git a/src/decoder/plugins/OggCodec.cxx b/src/decoder/plugins/OggCodec.cxx
index 3b7ee64..16b2e3c 100644
--- a/src/decoder/plugins/OggCodec.cxx
+++ b/src/decoder/plugins/OggCodec.cxx
@@ -17,8 +17,8 @@ ogg_codec_detect(DecoderClient *client, InputStream &is)
 	 * http://lists.xiph.org/pipermail/flac/2004-December/000393.html
 	 * ogg123 trunk still doesn't have this patch as of June 2005 */
 	std::byte buf[41];
-	size_t r = decoder_read(client, is, buf);
-	if (r < sizeof(buf) || memcmp(buf, "OggS", 4) != 0)
+	if (!decoder_read_full(client, is, buf) ||
+	    memcmp(buf, "OggS", 4) != 0)
 		return OGG_CODEC_UNKNOWN;
 
 	if ((memcmp(buf + 29, "FLAC", 4) == 0 &&
-- 
2.55.0

